Only Adwaita Sans, tagged runtime so pixiewood packs it into the APK
(install --tags runtime); the mono faces are 5.6 MB we do not use.
--- a/meson.build
+++ b/meson.build
@@ -20,4 +20,6 @@ sans = [
   'sans/AdwaitaSans-Regular.ttf',
 ]
 
-install_data(mono + sans, install_dir: fontsdir)
+install_data(sans, install_dir: fontsdir, install_tag: 'runtime')
+
+adwaita_fonts_dep = declare_dependency()
