diff --git a/gdk/ios/gdkiosruntime.c b/gdk/ios/gdkiosruntime.c
new file mode 100644
index 0000000..835625a
--- /dev/null
+++ b/gdk/ios/gdkiosruntime.c
@@ -0,0 +1,450 @@
+/*
+ * GDK iOS backend: UIKit application shell and the GTK thread.
+ *
+ * UIKit owns the process main thread; GTK runs on its own thread and
+ * talks to UIKit by dispatching blocks to the main queue. UIKit talks
+ * back by queueing idles on GTK's main context.
+ *
+ * SPDX-License-Identifier: LGPL-2.1-or-later
+ */
+
+#include "config.h"
+
+#import <UIKit/UIKit.h>
+
+#include <stdlib.h>
+
+#include "gdkiosruntime-private.h"
+#include "gdkiosdisplay-private.h"
+#include "gdkiossurface-private.h"
+#include "gdkiosevents-private.h"
+#include "gdkiostextinput-private.h"
+
+static GdkIosMainFunc gdk_ios_app_main = NULL;
+static int gdk_ios_argc = 0;
+static char **gdk_ios_argv = NULL;
+
+static UIWindow *gdk_ios_window = nil;
+static GdkIosRootView *gdk_ios_root_view = nil;
+static GThread *gdk_ios_gtk_thread = NULL;
+static volatile gint gdk_ios_ready = 0;
+
+static guint32 gdk_ios_bars_top = 0xffffffff;
+static guint32 gdk_ios_bars_bottom = 0xffffffff;
+
+static UIColor *
+gdk_ios_color_from_argb (guint32 argb)
+{
+  return [UIColor colorWithRed:((argb >> 16) & 0xff) / 255.0
+                         green:((argb >> 8) & 0xff) / 255.0
+                          blue:(argb & 0xff) / 255.0
+                         alpha:((argb >> 24) & 0xff) / 255.0];
+}
+
+@implementation GdkIosRootView
+
+/*
+ * Toplevel surfaces fill the whole window (edge to edge, under the
+ * status bar / home indicator / notch), shrinking only above the
+ * on-screen keyboard. The application pads its bars by the safe area,
+ * so their backgrounds and shadows reach the screen edges.
+ */
+- (void)layoutSubviews
+{
+  [super layoutSubviews];
+  CGRect frame = self.bounds;
+  if (self.keyboardTop > 0 && self.keyboardTop < CGRectGetMaxY (self.bounds))
+    frame.size.height = MAX (self.keyboardTop, 1);
+  for (UIView *child in self.subviews)
+    {
+      if ([child isKindOfClass:[GdkIosSurfaceView class]] && ((GdkIosSurfaceView *) child).gdkIsToplevel)
+        {
+          if (!CGRectEqualToRect (child.frame, frame))
+            child.frame = frame;
+        }
+    }
+  if (self.bottomStrip == nil)
+    {
+      self.bottomStrip = [[UIView alloc] initWithFrame:CGRectZero];
+      self.bottomStrip.userInteractionEnabled = NO;
+      [self insertSubview:self.bottomStrip atIndex:0];
+    }
+  self.bottomStrip.backgroundColor = gdk_ios_color_from_argb (gdk_ios_bars_bottom);
+  self.backgroundColor = gdk_ios_color_from_argb (gdk_ios_bars_top);
+}
+
+- (void)safeAreaInsetsDidChange
+{
+  [super safeAreaInsetsDidChange];
+  [self setNeedsLayout];
+}
+
+- (UIView *)hitTest:(CGPoint)point withEvent:(UIEvent *)event
+{
+  /* A GDK grab (autohide popups) routes every touch to the grabbed
+   * surface, even outside it, which is how GTK learns to close menus. */
+  if (self.grabbedView != nil && !self.grabbedView.hidden && self.grabbedView.superview != nil)
+    return self.grabbedView;
+  return [super hitTest:point withEvent:event];
+}
+
+@end
+
+static gboolean
+gdk_ios_runtime_dark_idle (gpointer data)
+{
+  GdkIosDisplay *display = gdk_ios_display_get_instance ();
+  if (display)
+    gdk_ios_display_set_dark (display, GPOINTER_TO_INT (data));
+  return G_SOURCE_REMOVE;
+}
+
+@interface GdkIosViewController : UIViewController
+@end
+
+@implementation GdkIosViewController
+
+- (BOOL)prefersStatusBarHidden
+{
+  return NO;
+}
+
+- (UIStatusBarStyle)preferredStatusBarStyle
+{
+  /* light text over a dark top bar */
+  double r = ((gdk_ios_bars_top >> 16) & 0xff) / 255.0;
+  double g = ((gdk_ios_bars_top >> 8) & 0xff) / 255.0;
+  double b = (gdk_ios_bars_top & 0xff) / 255.0;
+  return (0.299 * r + 0.587 * g + 0.114 * b) < 0.5 ? UIStatusBarStyleLightContent : UIStatusBarStyleDarkContent;
+}
+
+- (void)viewDidLoad
+{
+  [super viewDidLoad];
+  NSNotificationCenter *center = [NSNotificationCenter defaultCenter];
+  [center addObserver:self selector:@selector(keyboardWillChange:) name:UIKeyboardWillChangeFrameNotification object:nil];
+  [center addObserver:self selector:@selector(keyboardWillHide:) name:UIKeyboardWillHideNotification object:nil];
+}
+
+- (void)keyboardWillChange:(NSNotification *)note
+{
+  GdkIosRootView *root = (GdkIosRootView *) self.view;
+  CGRect end = [note.userInfo[UIKeyboardFrameEndUserInfoKey] CGRectValue];
+  CGRect local = [root convertRect:end fromView:nil];
+  CGFloat top = CGRectIntersectsRect (local, root.bounds) ? CGRectGetMinY (local) : 0;
+  if (top >= CGRectGetMaxY (root.bounds))
+    top = 0;
+  root.keyboardTop = top;
+  [root setNeedsLayout];
+  [root layoutIfNeeded];
+}
+
+- (void)keyboardWillHide:(NSNotification *)note
+{
+  GdkIosRootView *root = (GdkIosRootView *) self.view;
+  root.keyboardTop = 0;
+  [root setNeedsLayout];
+  [root layoutIfNeeded];
+}
+
+- (void)traitCollectionDidChange:(UITraitCollection *)previous
+{
+  [super traitCollectionDidChange:previous];
+  gboolean dark = self.traitCollection.userInterfaceStyle == UIUserInterfaceStyleDark;
+  gdk_ios_post_to_gtk (gdk_ios_runtime_dark_idle, GINT_TO_POINTER (dark), NULL);
+}
+
+@end
+
+static gpointer
+gdk_ios_gtk_thread_func (gpointer data)
+{
+  int ret = gdk_ios_app_main (gdk_ios_argc, gdk_ios_argv);
+  g_debug ("GTK main returned %d, exiting", ret);
+  dispatch_async (dispatch_get_main_queue (), ^{
+    exit (ret);
+  });
+  return NULL;
+}
+
+static void
+gdk_ios_runtime_debug_tap (double x, double y, double hold_ms)
+{
+  GdkIosRootView *root = gdk_ios_runtime_get_root_view ();
+  UIView *hit = [root hitTest:CGPointMake (x, y) withEvent:nil];
+  if (![hit isKindOfClass:[GdkIosSurfaceView class]])
+    {
+      NSLog (@"debug tap at %.0f,%.0f hit no surface view (%@)", x, y, hit);
+      return;
+    }
+  GdkIosSurfaceView *view = (GdkIosSurfaceView *) hit;
+  if (view.gdkSurface == NULL)
+    return;
+  CGPoint local = [root convertPoint:CGPointMake (x, y) toView:view];
+  guint sequence = (guint) g_random_int ();
+  guint32 now = (guint32) (g_get_monotonic_time () / 1000);
+  NSLog (@"debug tap at %.0f,%.0f hold %.0f -> surface %p local %.0f,%.0f", x, y, hold_ms, view.gdkSurface, local.x, local.y);
+  gdk_ios_events_post_touch (view.gdkSurface, GDK_TOUCH_BEGIN, sequence, local.x, local.y, now);
+  GdkIosSurface *surface = view.gdkSurface;
+  dispatch_after (dispatch_time (DISPATCH_TIME_NOW, (int64_t) (hold_ms * NSEC_PER_MSEC)), dispatch_get_main_queue (), ^{
+    if (view.gdkSurface == surface)
+      gdk_ios_events_post_touch (surface, GDK_TOUCH_END, sequence, local.x, local.y, now + (guint32) hold_ms);
+  });
+}
+
+static void
+gdk_ios_runtime_debug_drag (double x1, double y1, double x2, double y2)
+{
+  GdkIosRootView *root = gdk_ios_runtime_get_root_view ();
+  UIView *hit = [root hitTest:CGPointMake (x1, y1) withEvent:nil];
+  if (![hit isKindOfClass:[GdkIosSurfaceView class]])
+    {
+      NSLog (@"debug drag at %.0f,%.0f hit no surface view (%@)", x1, y1, hit);
+      return;
+    }
+  GdkIosSurfaceView *view = (GdkIosSurfaceView *) hit;
+  if (view.gdkSurface == NULL)
+    return;
+  GdkIosSurface *surface = view.gdkSurface;
+  guint sequence = (guint) g_random_int ();
+  guint32 now = (guint32) (g_get_monotonic_time () / 1000);
+  CGPoint start = [root convertPoint:CGPointMake (x1, y1) toView:view];
+  CGPoint end = [root convertPoint:CGPointMake (x2, y2) toView:view];
+  NSLog (@"debug drag %.0f,%.0f -> %.0f,%.0f on surface %p local %.0f,%.0f -> %.0f,%.0f",
+         x1, y1, x2, y2, surface, start.x, start.y, end.x, end.y);
+  gdk_ios_events_post_touch (surface, GDK_TOUCH_BEGIN, sequence, start.x, start.y, now);
+  for (int i = 1; i <= 4; i++)
+    {
+      double t = i / 4.0;
+      CGPoint p = CGPointMake (start.x + (end.x - start.x) * t,
+                               start.y + (end.y - start.y) * t);
+      dispatch_after (dispatch_time (DISPATCH_TIME_NOW, (int64_t) (i * 20) * NSEC_PER_MSEC), dispatch_get_main_queue (), ^{
+        if (view.gdkSurface == surface)
+          gdk_ios_events_post_touch (surface, GDK_TOUCH_UPDATE, sequence, p.x, p.y, now + (guint32) (i * 20));
+      });
+    }
+  dispatch_after (dispatch_time (DISPATCH_TIME_NOW, 110 * NSEC_PER_MSEC), dispatch_get_main_queue (), ^{
+    if (view.gdkSurface == surface)
+      gdk_ios_events_post_touch (surface, GDK_TOUCH_END, sequence, end.x, end.y, now + 110);
+  });
+}
+
+@interface GdkIosAppDelegate : UIResponder <UIApplicationDelegate>
+@end
+
+@implementation GdkIosAppDelegate
+
+- (BOOL)application:(UIApplication *)application didFinishLaunchingWithOptions:(NSDictionary *)options
+{
+  gdk_ios_window = [[UIWindow alloc] initWithFrame:[UIScreen mainScreen].bounds];
+  GdkIosViewController *controller = [[GdkIosViewController alloc] init];
+  gdk_ios_root_view = [[GdkIosRootView alloc] initWithFrame:gdk_ios_window.bounds];
+  gdk_ios_root_view.autoresizingMask = UIViewAutoresizingFlexibleWidth | UIViewAutoresizingFlexibleHeight;
+  gdk_ios_root_view.backgroundColor = [UIColor blackColor];
+  gdk_ios_root_view.multipleTouchEnabled = YES;
+  controller.view = gdk_ios_root_view;
+  gdk_ios_window.rootViewController = controller;
+  [gdk_ios_window makeKeyAndVisible];
+
+  g_atomic_int_set (&gdk_ios_ready, 1);
+  gdk_ios_runtime_log ("GDK iOS runtime: window up, starting GTK thread");
+  gdk_ios_gtk_thread = g_thread_new ("GTK Thread", gdk_ios_gtk_thread_func, NULL);
+
+  /* GDK_IOS_DEBUG_TYPE="ms:text": type text on the on-screen keyboard
+   * responder after ms milliseconds ("\n" for return, "\b" for backspace). */
+  const char *type_spec = g_getenv ("GDK_IOS_DEBUG_TYPE");
+  if (type_spec != NULL && strchr (type_spec, ':') != NULL)
+    {
+      int ms = atoi (type_spec);
+      char *text = g_strdup (strchr (type_spec, ':') + 1);
+      dispatch_after (dispatch_time (DISPATCH_TIME_NOW, (int64_t) ms * NSEC_PER_MSEC), dispatch_get_main_queue (), ^{
+        UIView<UIKeyInput> *input = (UIView<UIKeyInput> *) gdk_ios_text_input_get_view ();
+        NSLog (@"debug type: first responder %d", input.isFirstResponder);
+        for (const char *p = text; *p != '\0'; p = g_utf8_next_char (p))
+          {
+            gunichar ch = g_utf8_get_char (p);
+            if (ch == '\b')
+              [input deleteBackward];
+            else
+              {
+                char buf[8] = { 0 };
+                g_unichar_to_utf8 (ch, buf);
+                [input insertText:[NSString stringWithUTF8String:buf]];
+              }
+          }
+        g_free (text);
+      });
+    }
+
+  /* GDK_IOS_DEBUG_TAPS="x,y,ms;x,y,ms" (optional 4th field: hold ms):
+   * synthesize taps (in points) for automated checks in the simulator,
+   * where nothing can inject touches. */
+  const char *taps = g_getenv ("GDK_IOS_DEBUG_TAPS");
+  if (taps != NULL)
+    {
+      char **list = g_strsplit (taps, ";", -1);
+      for (int i = 0; list[i] != NULL; i++)
+        {
+          double x = 0, y = 0;
+          int ms = 1000;
+          int hold = 80;
+          if (sscanf (list[i], "%lf,%lf,%d,%d", &x, &y, &ms, &hold) < 2)
+            continue;
+          dispatch_after (dispatch_time (DISPATCH_TIME_NOW, (int64_t) ms * NSEC_PER_MSEC), dispatch_get_main_queue (), ^{
+            gdk_ios_runtime_debug_tap (x, y, hold);
+          });
+        }
+      g_strfreev (list);
+    }
+
+  /* GDK_IOS_DEBUG_DRAGS="x1,y1,x2,y2,ms;…": synthesize a touch drag (in
+   * points) after ms, for scrolling checks without hands. */
+  const char *drags = g_getenv ("GDK_IOS_DEBUG_DRAGS");
+  if (drags != NULL)
+    {
+      char **list = g_strsplit (drags, ";", -1);
+      for (int i = 0; list[i] != NULL; i++)
+        {
+          double x1 = 0, y1 = 0, x2 = 0, y2 = 0;
+          int ms = 1000;
+          if (sscanf (list[i], "%lf,%lf,%lf,%lf,%d", &x1, &y1, &x2, &y2, &ms) < 4)
+            continue;
+          dispatch_after (dispatch_time (DISPATCH_TIME_NOW, (int64_t) ms * NSEC_PER_MSEC), dispatch_get_main_queue (), ^{
+            gdk_ios_runtime_debug_drag (x1, y1, x2, y2);
+          });
+        }
+      g_strfreev (list);
+    }
+  return YES;
+}
+
+@end
+
+/* GLib messages go to stderr, which nobody sees on a device: mirror
+ * them into the unified log (Console.app, `log stream`). */
+static GLogWriterOutput
+gdk_ios_runtime_log_writer (GLogLevelFlags   log_level,
+                            const GLogField *fields,
+                            gsize            n_fields,
+                            gpointer         user_data)
+{
+  const char *message = NULL;
+  const char *domain = NULL;
+  for (gsize i = 0; i < n_fields; i++)
+    {
+      if (g_strcmp0 (fields[i].key, "MESSAGE") == 0)
+        message = fields[i].value;
+      else if (g_strcmp0 (fields[i].key, "GLIB_DOMAIN") == 0)
+        domain = fields[i].value;
+    }
+  const char *level = "";
+  if (log_level & G_LOG_LEVEL_ERROR) level = "ERROR";
+  else if (log_level & G_LOG_LEVEL_CRITICAL) level = "CRITICAL";
+  else if (log_level & G_LOG_LEVEL_WARNING) level = "WARNING";
+  else if (log_level & G_LOG_LEVEL_MESSAGE) level = "MESSAGE";
+  else if (log_level & G_LOG_LEVEL_INFO) level = "INFO";
+  else if (log_level & G_LOG_LEVEL_DEBUG) level = "DEBUG";
+  NSLog (@"[%s] %s: %s", domain ? domain : "?", level, message ? message : "");
+  return g_log_writer_standard_streams (log_level, fields, n_fields, user_data);
+}
+
+int
+gdk_ios_main (int argc, char **argv, GdkIosMainFunc app_main)
+{
+  gdk_ios_app_main = app_main;
+  g_log_set_writer_func (gdk_ios_runtime_log_writer, NULL, NULL);
+  gdk_ios_argc = argc;
+  gdk_ios_argv = argv;
+
+  g_setenv ("GDK_BACKEND", "ios", TRUE);
+  /* static GIO has no module directory compiled in; give it one so it
+   * does not try to scan a NULL path */
+  if (g_getenv ("GIO_MODULE_DIR") == NULL)
+    g_setenv ("GIO_MODULE_DIR", [[[NSBundle mainBundle] bundlePath] UTF8String], TRUE);
+  if (g_getenv ("GSK_RENDERER") == NULL)
+    g_setenv ("GSK_RENDERER", "cairo", TRUE);
+
+  @autoreleasepool {
+    return UIApplicationMain (argc, argv, nil, NSStringFromClass ([GdkIosAppDelegate class]));
+  }
+}
+
+void
+gdk_ios_set_bars_colors (guint32 top_argb, guint32 bottom_argb)
+{
+  gdk_ios_bars_top = top_argb;
+  gdk_ios_bars_bottom = bottom_argb;
+  gdk_ios_run_on_main_async (^{
+    GdkIosRootView *root = gdk_ios_runtime_get_root_view ();
+    [root setNeedsLayout];
+    [gdk_ios_window.rootViewController setNeedsStatusBarAppearanceUpdate];
+  });
+}
+
+void
+gdk_ios_get_safe_area (int *top, int *bottom, int *left, int *right)
+{
+  __block UIEdgeInsets insets = UIEdgeInsetsZero;
+
+  gdk_ios_run_on_main_sync (^{
+    GdkIosRootView *root = gdk_ios_runtime_get_root_view ();
+    if (root != nil)
+      insets = root.safeAreaInsets;
+  });
+
+  if (top != NULL)
+    *top = (int) ceil (insets.top);
+  if (bottom != NULL)
+    *bottom = (int) ceil (insets.bottom);
+  if (left != NULL)
+    *left = (int) ceil (insets.left);
+  if (right != NULL)
+    *right = (int) ceil (insets.right);
+}
+
+gboolean
+gdk_ios_runtime_is_ready (void)
+{
+  return g_atomic_int_get (&gdk_ios_ready) != 0;
+}
+
+GdkIosRootView *
+gdk_ios_runtime_get_root_view (void)
+{
+  return gdk_ios_root_view;
+}
+
+UIWindow *
+gdk_ios_runtime_get_window (void)
+{
+  return gdk_ios_window;
+}
+
+void
+gdk_ios_run_on_main_sync (void (^block)(void))
+{
+  if ([NSThread isMainThread])
+    block ();
+  else
+    dispatch_sync (dispatch_get_main_queue (), block);
+}
+
+void
+gdk_ios_run_on_main_async (void (^block)(void))
+{
+  dispatch_async (dispatch_get_main_queue (), block);
+}
+
+void
+gdk_ios_post_to_gtk (GSourceFunc func, gpointer data, GDestroyNotify destroy)
+{
+  /* g_idle_add always queues on the default context, which the GTK
+   * thread iterates; never run inline on the caller's thread. */
+  g_idle_add_full (G_PRIORITY_DEFAULT, func, data, destroy);
+}
+
+void
+gdk_ios_runtime_log (const char *message)
+{
+  NSLog (@"%s", message);
+}
diff --git a/gdk/ios/gdkiosruntime.h b/gdk/ios/gdkiosruntime.h
