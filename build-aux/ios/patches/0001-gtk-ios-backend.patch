diff --git a/gdk/ios/gdkiossurface.c b/gdk/ios/gdkiossurface.c
new file mode 100644
index 0000000..9af8ca7
--- /dev/null
+++ b/gdk/ios/gdkiossurface.c
@@ -0,0 +1,399 @@
+/* GDK iOS backend: GdkSurface backed by a UIView. SPDX-License-Identifier: LGPL-2.1-or-later */
+
+#include "config.h"
+
+#import <UIKit/UIKit.h>
+#import <QuartzCore/QuartzCore.h>
+
+#include <math.h>
+
+#include "gdkframeclockidleprivate.h"
+#include "gdkframeclockprivate.h"
+
+#include "gdkiosruntime-private.h"
+#include "gdkiosdisplay-private.h"
+#include "gdkiosseat-private.h"
+#include "gdkiosevents-private.h"
+#include "gdkiostoplevel-private.h"
+
+#include "gdkiossurface-private.h"
+
+/* ── the view (main thread) ─────────────────────────────────────────── */
+
+typedef struct
+{
+  GdkIosSurface *surface;
+  int x, y, width, height;
+  double scale;
+} GdkIosLayout;
+
+static gboolean
+gdk_ios_surface_layout_idle (gpointer data)
+{
+  GdkIosLayout *layout = data;
+  if (!GDK_SURFACE_DESTROYED ((GdkSurface *) layout->surface))
+    gdk_ios_surface_on_layout (layout->surface, layout->x, layout->y, layout->width, layout->height, layout->scale);
+  return G_SOURCE_REMOVE;
+}
+
+static void
+gdk_ios_surface_layout_free (gpointer data)
+{
+  GdkIosLayout *layout = data;
+  g_object_unref (layout->surface);
+  g_free (layout);
+}
+
+@implementation GdkIosSurfaceView
+
+- (instancetype)initWithFrame:(CGRect)frame
+{
+  self = [super initWithFrame:frame];
+  if (self)
+    {
+      self.multipleTouchEnabled = YES;
+      self.userInteractionEnabled = YES;
+      self.opaque = NO;
+      self.layer.contentsGravity = kCAGravityTopLeft;
+    }
+  return self;
+}
+
+- (void)layoutSubviews
+{
+  [super layoutSubviews];
+  if (self.gdkSurface == NULL)
+    return;
+  CGRect frame = self.frame;
+  GdkIosLayout *layout = g_new0 (GdkIosLayout, 1);
+  layout->surface = g_object_ref (self.gdkSurface);
+  layout->x = (int) floor (frame.origin.x);
+  layout->y = (int) floor (frame.origin.y);
+  layout->width = (int) ceil (frame.size.width);
+  layout->height = (int) ceil (frame.size.height);
+  layout->scale = self.window != nil ? self.window.screen.scale : [UIScreen mainScreen].scale;
+  gdk_ios_post_to_gtk (gdk_ios_surface_layout_idle, layout, gdk_ios_surface_layout_free);
+}
+
+- (void)forwardTouches:(NSSet<UITouch *> *)touches type:(GdkEventType)type
+{
+  if (self.gdkSurface == NULL)
+    return;
+  for (UITouch *touch in touches)
+    {
+      CGPoint p = [touch locationInView:self];
+      guint sequence = (guint) (((uintptr_t) touch) >> 4);
+      gdk_ios_events_post_touch (self.gdkSurface, type, sequence, p.x, p.y,
+                                 (guint32) (touch.timestamp * 1000.0));
+    }
+}
+
+- (void)touchesBegan:(NSSet<UITouch *> *)touches withEvent:(UIEvent *)event
+{
+  [self forwardTouches:touches type:GDK_TOUCH_BEGIN];
+}
+
+- (void)touchesMoved:(NSSet<UITouch *> *)touches withEvent:(UIEvent *)event
+{
+  [self forwardTouches:touches type:GDK_TOUCH_UPDATE];
+}
+
+- (void)touchesEnded:(NSSet<UITouch *> *)touches withEvent:(UIEvent *)event
+{
+  [self forwardTouches:touches type:GDK_TOUCH_END];
+}
+
+- (void)touchesCancelled:(NSSet<UITouch *> *)touches withEvent:(UIEvent *)event
+{
+  [self forwardTouches:touches type:GDK_TOUCH_CANCEL];
+}
+
+@end
+
+/* ── the surface (GTK thread) ───────────────────────────────────────── */
+
+G_DEFINE_TYPE (GdkIosSurface, gdk_ios_surface, GDK_TYPE_SURFACE)
+
+static void
+gdk_ios_surface_reposition_children (GdkIosSurface *self)
+{
+  for (const GList *iter = GDK_SURFACE (self)->children; iter != NULL; iter = iter->next)
+    {
+      GdkIosSurface *child = iter->data;
+      GdkIosSurfaceClass *klass = GDK_IOS_SURFACE_GET_CLASS (child);
+      if (klass->reposition)
+        klass->reposition (child);
+    }
+}
+
+void
+gdk_ios_surface_on_layout (GdkIosSurface *self, int x, int y, int width, int height, double scale)
+{
+  GdkSurface *surface = (GdkSurface *) self;
+
+  if (self->cfg.x == x && self->cfg.y == y && self->cfg.width == width &&
+      self->cfg.height == height && self->cfg.scale == scale)
+    return;
+
+  self->cfg.x = x;
+  self->cfg.y = y;
+  self->cfg.width = width;
+  self->cfg.height = height;
+  self->cfg.scale = scale;
+
+  g_debug ("iOS surface %p [%s]: %dx%d at (%d|%d) @%.1f", self, G_OBJECT_TYPE_NAME (self),
+           width, height, x, y, scale);
+
+  surface->width = width;
+  surface->height = height;
+  surface->x = x;
+  surface->y = y;
+
+  GdkIosSurfaceClass *klass = GDK_IOS_SURFACE_GET_CLASS (self);
+  if (klass->on_layout)
+    klass->on_layout (self);
+
+  _gdk_surface_update_size (surface);
+  gdk_ios_surface_reposition_children (self);
+  gdk_surface_invalidate_rect (surface, NULL);
+  gdk_surface_request_layout (surface);
+}
+
+void
+gdk_ios_surface_ensure_view (GdkIosSurface *self)
+{
+  if (self->view != NULL)
+    return;
+  __block GdkIosSurfaceView *view = nil;
+  gdk_ios_run_on_main_sync (^{
+    view = [[GdkIosSurfaceView alloc] initWithFrame:CGRectZero];
+    view.gdkSurface = self;
+    view.hidden = YES;
+  });
+  self->view = view;
+}
+
+/*
+ * Puts the view into the root view (toplevels, @frame_points NULL: fill
+ * the root) or into @parent's view at @frame_points, shows it, and
+ * records the resulting geometry in cfg.
+ */
+void
+gdk_ios_surface_attach (GdkIosSurface *self, GdkIosSurface *parent, const GdkRectangle *frame_points)
+{
+  gdk_ios_surface_ensure_view (self);
+  GdkIosSurfaceView *view = (GdkIosSurfaceView *) self->view;
+  UIView *parent_view = parent != NULL ? (UIView *) parent->view : nil;
+  GdkRectangle frame = frame_points != NULL ? *frame_points : (GdkRectangle){ 0, 0, 0, 0 };
+  __block GdkIosLayout result = { 0 };
+
+  gdk_ios_run_on_main_sync (^{
+    UIView *container = parent_view != nil ? parent_view : (UIView *) gdk_ios_runtime_get_root_view ();
+    if (view.superview != container)
+      {
+        [view removeFromSuperview];
+        [container addSubview:view];
+      }
+    if (frame_points == NULL)
+      {
+        /* the root view lays toplevels out: safe area minus keyboard */
+        view.gdkIsToplevel = YES;
+        [container setNeedsLayout];
+        [container layoutIfNeeded];
+      }
+    else
+      {
+        view.gdkIsToplevel = NO;
+        view.frame = CGRectMake (frame.x, frame.y, frame.width, frame.height);
+      }
+    view.autoresizingMask = UIViewAutoresizingNone;
+    [container bringSubviewToFront:view];
+    view.hidden = NO;
+    CGRect f = view.frame;
+    result.x = (int) floor (f.origin.x);
+    result.y = (int) floor (f.origin.y);
+    result.width = (int) ceil (f.size.width);
+    result.height = (int) ceil (f.size.height);
+    result.scale = container.window != nil ? container.window.screen.scale : [UIScreen mainScreen].scale;
+  });
+
+  int root_x = result.x + (parent != NULL ? parent->cfg.x : 0);
+  int root_y = result.y + (parent != NULL ? parent->cfg.y : 0);
+  gdk_ios_surface_on_layout (self, root_x, root_y, result.width, result.height, result.scale);
+}
+
+void
+gdk_ios_surface_set_visible (GdkIosSurface *self, gboolean visible)
+{
+  if (self->view == NULL)
+    return;
+  UIView *view = (UIView *) self->view;
+  gdk_ios_run_on_main_async (^{
+    view.hidden = !visible;
+  });
+}
+
+void
+gdk_ios_surface_handle_map (GdkIosSurface *self)
+{
+  GdkSurface *surface = (GdkSurface *) self;
+  GdkIosDisplay *display = (GdkIosDisplay *) gdk_surface_get_display (surface);
+
+  gdk_surface_set_is_mapped (surface, TRUE);
+
+  if (surface->autohide)
+    {
+      gdk_seat_grab ((GdkSeat *) display->seat, surface);
+      self->popup_grab = TRUE;
+    }
+}
+
+static void
+gdk_ios_surface_finalize (GObject *object)
+{
+  GdkIosSurface *self = (GdkIosSurface *) object;
+  if (self->view != NULL)
+    {
+      UIView *view = (UIView *) self->view;
+      self->view = NULL;
+      gdk_ios_run_on_main_async (^{
+        [view removeFromSuperview];
+        [view release];
+      });
+    }
+  G_OBJECT_CLASS (gdk_ios_surface_parent_class)->finalize (object);
+}
+
+static void
+gdk_ios_surface_constructed (GObject *object)
+{
+  GdkIosSurface *self = (GdkIosSurface *) object;
+  GdkSurface *surface = (GdkSurface *) self;
+
+  GdkFrameClock *frame_clock = _gdk_frame_clock_idle_new ();
+  gdk_surface_set_frame_clock (surface, frame_clock);
+  g_object_unref (frame_clock);
+
+  G_OBJECT_CLASS (gdk_ios_surface_parent_class)->constructed (object);
+}
+
+static void
+gdk_ios_surface_hide (GdkSurface *surface)
+{
+  GdkIosSurface *self = (GdkIosSurface *) surface;
+
+  self->visible = FALSE;
+
+  if (surface->autohide && self->popup_grab)
+    {
+      GdkSeat *seat = gdk_display_get_default_seat (surface->display);
+      gdk_seat_ungrab (seat, surface);
+      self->popup_grab = FALSE;
+    }
+
+  gdk_ios_surface_set_visible (self, FALSE);
+  gdk_surface_set_is_mapped (surface, FALSE);
+}
+
+static void
+gdk_ios_surface_get_geometry (GdkSurface *surface, int *x, int *y, int *width, int *height)
+{
+  GdkSurface *parent = surface->parent;
+  *x = surface->x - (parent ? parent->x : 0);
+  *y = surface->y - (parent ? parent->y : 0);
+  *width = surface->width;
+  *height = surface->height;
+}
+
+static void
+gdk_ios_surface_get_root_coords (GdkSurface *surface, int x, int y, int *root_x, int *root_y)
+{
+  *root_x = x + surface->x;
+  *root_y = y + surface->y;
+}
+
+static gboolean
+gdk_ios_surface_get_device_state (GdkSurface *surface, GdkDevice *device,
+                                  double *x, double *y, GdkModifierType *mask)
+{
+  return gdk_device_get_surface_at_position (device, x, y) == surface;
+}
+
+static void
+gdk_ios_surface_set_input_region (GdkSurface *surface, cairo_region_t *shape_region)
+{
+}
+
+static void
+gdk_ios_surface_destroy (GdkSurface *surface, gboolean foreign_destroy)
+{
+  GdkIosSurface *self = (GdkIosSurface *) surface;
+  GdkIosDisplay *display = (GdkIosDisplay *) gdk_surface_get_display (surface);
+
+  g_debug ("iOS surface %p destroy", self);
+
+  if (display != NULL && display->seat != NULL)
+    {
+      gdk_ios_device_forget_surface ((GdkIosDevice *) display->seat->logical_pointer, self);
+      gdk_ios_device_forget_surface ((GdkIosDevice *) display->seat->logical_keyboard, self);
+      if (display->seat->grab_surface == self)
+        gdk_seat_ungrab ((GdkSeat *) display->seat, surface);
+    }
+
+  if (self->view != NULL)
+    {
+      GdkIosSurfaceView *view = (GdkIosSurfaceView *) self->view;
+      self->view = NULL;
+      gdk_ios_run_on_main_sync (^{
+        view.gdkSurface = NULL;
+        [view removeFromSuperview];
+        [view release];
+      });
+    }
+}
+
+static double
+gdk_ios_surface_get_scale (GdkSurface *surface)
+{
+  return ((GdkIosSurface *) surface)->cfg.scale;
+}
+
+static gboolean
+gdk_ios_surface_compute_size (GdkSurface *surface)
+{
+  return FALSE;
+}
+
+static void
+gdk_ios_surface_class_init (GdkIosSurfaceClass *klass)
+{
+  GObjectClass *object_class = G_OBJECT_CLASS (klass);
+  GdkSurfaceClass *surface_class = GDK_SURFACE_CLASS (klass);
+
+  object_class->finalize = gdk_ios_surface_finalize;
+  object_class->constructed = gdk_ios_surface_constructed;
+
+  surface_class->hide = gdk_ios_surface_hide;
+  surface_class->get_geometry = gdk_ios_surface_get_geometry;
+  surface_class->get_root_coords = gdk_ios_surface_get_root_coords;
+  surface_class->get_device_state = gdk_ios_surface_get_device_state;
+  surface_class->set_input_region = gdk_ios_surface_set_input_region;
+  surface_class->destroy = gdk_ios_surface_destroy;
+  surface_class->get_scale = gdk_ios_surface_get_scale;
+  surface_class->compute_size = gdk_ios_surface_compute_size;
+}
+
+static void
+gdk_ios_surface_init (GdkIosSurface *self)
+{
+  self->cfg = (GdkIosSurfaceConfiguration){ .x = 0, .y = 0, .width = 0, .height = 0, .scale = 1.0 };
+}
+
+GdkIosToplevel *
+gdk_ios_surface_get_toplevel (GdkIosSurface *self)
+{
+  GdkSurface *surface = (GdkSurface *) self;
+  if (surface->parent)
+    return gdk_ios_surface_get_toplevel (GDK_IOS_SURFACE (surface->parent));
+  return GDK_IOS_TOPLEVEL (self);
+}
