diff --git a/gdk/ios/gdkiospopup.c b/gdk/ios/gdkiospopup.c
new file mode 100644
index 0000000..00459b0
--- /dev/null
+++ b/gdk/ios/gdkiospopup.c
@@ -0,0 +1,181 @@
+/* GDK iOS backend: GdkPopup as a subview of its toplevel. SPDX-License-Identifier: LGPL-2.1-or-later */
+
+#include "config.h"
+
+#include <string.h>
+
+#include "gdkpopuplayout.h"
+
+#include "gdkiosruntime-private.h"
+#include "gdkiostoplevel-private.h"
+
+#include "gdkiospopup-private.h"
+
+static gboolean
+gdk_ios_popup_present (GdkPopup *popup, int width, int height, GdkPopupLayout *layout)
+{
+  GdkIosPopup *self = (GdkIosPopup *) popup;
+  GdkIosSurface *impl = (GdkIosSurface *) self;
+  GdkSurface *surface = (GdkSurface *) self;
+
+  GdkIosToplevel *parent = gdk_ios_surface_get_toplevel (impl);
+  GdkIosSurface *parent_impl = (GdkIosSurface *) parent;
+  GdkSurface *parent_surface = (GdkSurface *) parent;
+
+  impl->visible = TRUE;
+
+  gdk_popup_layout_ref (layout);
+  g_clear_pointer (&self->layout, gdk_popup_layout_unref);
+  self->layout = layout;
+
+  int shadow_left, shadow_right, shadow_top, shadow_bottom;
+  gdk_popup_layout_get_shadow_width (layout, &shadow_left, &shadow_right, &shadow_top, &shadow_bottom);
+
+  GdkRectangle bounds = { 0, 0, parent_surface->width, parent_surface->height };
+
+  memset (&self->popup_bounds, 0, sizeof (GdkRectangle));
+  gdk_surface_layout_popup_helper (surface, width, height,
+                                   shadow_left, shadow_right, shadow_top, shadow_bottom,
+                                   NULL, &bounds, self->layout,
+                                   GDK_SURFACE_LAYOUT_POPUP_HELPER_DEFAULT,
+                                   &self->popup_bounds);
+
+  g_debug ("iOS popup present %p: %dx%d at (%d|%d)", self,
+           self->popup_bounds.width, self->popup_bounds.height, self->popup_bounds.x, self->popup_bounds.y);
+
+  gdk_ios_surface_attach (impl, parent_impl, &self->popup_bounds);
+
+  if (!GDK_SURFACE_IS_MAPPED (surface))
+    gdk_ios_surface_handle_map (impl);
+
+  return TRUE;
+}
+
+static GdkGravity
+gdk_ios_popup_get_surface_anchor (GdkPopup *popup)
+{
+  return GDK_SURFACE (popup)->popup.surface_anchor;
+}
+
+static GdkGravity
+gdk_ios_popup_get_rect_anchor (GdkPopup *popup)
+{
+  return GDK_SURFACE (popup)->popup.rect_anchor;
+}
+
+static int
+gdk_ios_popup_get_position_x (GdkPopup *popup)
+{
+  GdkSurface *surface = (GdkSurface *) popup;
+  return surface->x - (surface->parent ? surface->parent->x : 0);
+}
+
+static int
+gdk_ios_popup_get_position_y (GdkPopup *popup)
+{
+  GdkSurface *surface = (GdkSurface *) popup;
+  return surface->y - (surface->parent ? surface->parent->y : 0);
+}
+
+static void
+gdk_ios_popup_iface_init (GdkPopupInterface *iface)
+{
+  iface->present = gdk_ios_popup_present;
+  iface->get_surface_anchor = gdk_ios_popup_get_surface_anchor;
+  iface->get_rect_anchor = gdk_ios_popup_get_rect_anchor;
+  iface->get_position_x = gdk_ios_popup_get_position_x;
+  iface->get_position_y = gdk_ios_popup_get_position_y;
+}
+
+G_DEFINE_TYPE_WITH_CODE (GdkIosPopup, gdk_ios_popup, GDK_TYPE_IOS_SURFACE,
+                         G_IMPLEMENT_INTERFACE (GDK_TYPE_POPUP, gdk_ios_popup_iface_init))
+
+enum
+{
+  N_PROPERTIES = 1,
+};
+
+static void
+gdk_ios_popup_finalize (GObject *object)
+{
+  GdkIosPopup *self = (GdkIosPopup *) object;
+  GdkSurface *parent = ((GdkSurface *) self)->parent;
+
+  if (parent != NULL)
+    parent->children = g_list_remove (parent->children, self);
+
+  g_clear_object (&GDK_SURFACE (self)->parent);
+  g_clear_pointer (&self->layout, gdk_popup_layout_unref);
+
+  G_OBJECT_CLASS (gdk_ios_popup_parent_class)->finalize (object);
+}
+
+static void
+gdk_ios_popup_get_property (GObject *object, guint prop_id, GValue *value, GParamSpec *pspec)
+{
+  GdkSurface *surface = GDK_SURFACE (object);
+
+  switch (prop_id)
+    {
+    case N_PROPERTIES + GDK_POPUP_PROP_PARENT:
+      g_value_set_object (value, surface->parent);
+      break;
+    case N_PROPERTIES + GDK_POPUP_PROP_AUTOHIDE:
+      g_value_set_boolean (value, surface->autohide);
+      break;
+    default:
+      G_OBJECT_WARN_INVALID_PROPERTY_ID (object, prop_id, pspec);
+    }
+}
+
+static void
+gdk_ios_popup_set_property (GObject *object, guint prop_id, const GValue *value, GParamSpec *pspec)
+{
+  GdkSurface *surface = (GdkSurface *) object;
+
+  switch (prop_id)
+    {
+    case N_PROPERTIES + GDK_POPUP_PROP_PARENT:
+      surface->parent = g_value_dup_object (value);
+      if (surface->parent)
+        surface->parent->children = g_list_prepend (surface->parent->children, surface);
+      break;
+    case N_PROPERTIES + GDK_POPUP_PROP_AUTOHIDE:
+      surface->autohide = g_value_get_boolean (value);
+      break;
+    default:
+      G_OBJECT_WARN_INVALID_PROPERTY_ID (object, prop_id, pspec);
+    }
+}
+
+static void
+gdk_ios_popup_reposition (GdkIosSurface *impl)
+{
+  GdkIosPopup *self = (GdkIosPopup *) impl;
+  GdkSurface *surface = (GdkSurface *) self;
+
+  if (self->layout == NULL || surface->parent == NULL || !impl->visible)
+    return;
+
+  gdk_ios_popup_present ((GdkPopup *) self, surface->width, surface->height, self->layout);
+}
+
+static void
+gdk_ios_popup_class_init (GdkIosPopupClass *klass)
+{
+  GObjectClass *object_class = G_OBJECT_CLASS (klass);
+  GdkIosSurfaceClass *surface_impl_class = GDK_IOS_SURFACE_CLASS (klass);
+
+  object_class->finalize = gdk_ios_popup_finalize;
+  object_class->get_property = gdk_ios_popup_get_property;
+  object_class->set_property = gdk_ios_popup_set_property;
+
+  surface_impl_class->reposition = gdk_ios_popup_reposition;
+
+  gdk_popup_install_properties (object_class, N_PROPERTIES);
+}
+
+static void
+gdk_ios_popup_init (GdkIosPopup *self)
+{
+}
