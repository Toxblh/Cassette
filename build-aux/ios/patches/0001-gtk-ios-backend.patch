+#pragma once
+
+#include <gdk/gdk.h>
+
+G_BEGIN_DECLS
+
+/**
+ * GdkIosMainFunc:
+ *
+ * The application's real main: runs on the GTK thread once UIKit is up.
+ */
+typedef int (*GdkIosMainFunc) (int argc, char **argv);
+
+/**
+ * gdk_ios_main:
+ *
+ * Hands the process to UIKit and runs @app_main on a dedicated GTK
+ * thread once the application has finished launching. Never returns.
+ */
+GDK_AVAILABLE_IN_ALL
+int gdk_ios_main (int argc, char **argv, GdkIosMainFunc app_main);
+
+/**
+ * gdk_ios_set_bars_colors:
+ *
+ * Colours (0xAARRGGBB) painted under the status bar and the home
+ * indicator, where the toplevel does not reach. Any thread.
+ */
+GDK_AVAILABLE_IN_ALL
+void gdk_ios_set_bars_colors (guint32 top_argb, guint32 bottom_argb);
+
+/**
+ * gdk_ios_get_safe_area:
+ *
+ * The window's safe-area insets in points (status bar, home indicator,
+ * notch). Toplevels fill the whole window, so the application pads its
+ * bars by these. Any thread.
+ */
+GDK_AVAILABLE_IN_ALL
+void gdk_ios_get_safe_area (int *top, int *bottom, int *left, int *right);
+
+G_END_DECLS
