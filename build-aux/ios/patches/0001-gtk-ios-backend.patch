diff --git a/gdk/ios/gdkiosevents.c b/gdk/ios/gdkiosevents.c
new file mode 100644
index 0000000..01bd8ba
--- /dev/null
+++ b/gdk/ios/gdkiosevents.c
@@ -0,0 +1,140 @@
+/* GDK iOS backend: UIKit input → GDK events. SPDX-License-Identifier: LGPL-2.1-or-later */
+
+#include "config.h"
+
+#include "gdkeventsprivate.h"
+#include "gdkkeysyms.h"
+
+#include "gdkiosruntime-private.h"
+#include "gdkiosdisplay-private.h"
+#include "gdkiosseat-private.h"
+#include "gdkiostoplevel-private.h"
+
+#include "gdkiosevents-private.h"
+
+typedef struct
+{
+  GdkIosSurface *surface;
+  GdkEventType type;
+  guint sequence;
+  double x;
+  double y;
+  guint32 time;
+} GdkIosTouch;
+
+static void
+gdk_ios_events_handle_touch (GdkIosTouch *touch)
+{
+  GdkIosSurface *surface = touch->surface;
+  GdkSurface *gdk_surface = (GdkSurface *) surface;
+  if (GDK_SURFACE_DESTROYED (gdk_surface) || !gdk_surface->is_mapped)
+    return;
+
+  GdkIosDisplay *display = (GdkIosDisplay *) gdk_surface_get_display (gdk_surface);
+  GdkIosSeat *seat = display->seat;
+
+  /* Keyboard focus follows touches, for toplevels and grabbing popups. */
+  if (GDK_IS_IOS_TOPLEVEL (surface) || gdk_surface->autohide)
+    gdk_ios_device_keyboard_maybe_update_surface_focus ((GdkIosDevice *) seat->logical_keyboard, surface);
+
+  if (touch->type == GDK_TOUCH_BEGIN)
+    gdk_ios_device_maybe_update_surface ((GdkIosDevice *) seat->logical_pointer, surface,
+                                         0, touch->time, touch->x, touch->y);
+
+  gboolean emulating = FALSE;
+  if (touch->type == GDK_TOUCH_BEGIN && !surface->has_emulating)
+    {
+      surface->has_emulating = TRUE;
+      surface->emulating_sequence = touch->sequence;
+    }
+  if (surface->has_emulating && surface->emulating_sequence == touch->sequence)
+    {
+      emulating = TRUE;
+      if (touch->type == GDK_TOUCH_END || touch->type == GDK_TOUCH_CANCEL)
+        surface->has_emulating = FALSE;
+    }
+
+  double *axes = g_new0 (double, GDK_AXIS_LAST);
+  axes[GDK_AXIS_X] = touch->x;
+  axes[GDK_AXIS_Y] = touch->y;
+
+  GdkEvent *ev = gdk_touch_event_new (touch->type, GUINT_TO_POINTER (touch->sequence),
+                                      gdk_surface, seat->logical_touchscreen,
+                                      touch->time, 0, touch->x, touch->y, axes, emulating);
+  gdk_ios_seat_consume_event ((GdkDisplay *) display, ev);
+}
+
+static gboolean
+gdk_ios_events_touch_idle (gpointer data)
+{
+  gdk_ios_events_handle_touch ((GdkIosTouch *) data);
+  return G_SOURCE_REMOVE;
+}
+
+static void
+gdk_ios_events_touch_free (gpointer data)
+{
+  GdkIosTouch *touch = data;
+  g_object_unref (touch->surface);
+  g_free (touch);
+}
+
+void
+gdk_ios_events_post_touch (GdkIosSurface *surface, GdkEventType type, guint sequence,
+                           double x, double y, guint32 time)
+{
+  GdkIosTouch *touch = g_new0 (GdkIosTouch, 1);
+  touch->surface = g_object_ref (surface);
+  touch->type = type;
+  touch->sequence = sequence;
+  touch->x = x;
+  touch->y = y;
+  touch->time = time;
+  gdk_ios_post_to_gtk (gdk_ios_events_touch_idle, touch, gdk_ios_events_touch_free);
+}
+
+typedef struct
+{
+  GdkIosSurface *surface;
+  guint keyval;
+} GdkIosKey;
+
+static gboolean
+gdk_ios_events_key_idle (gpointer data)
+{
+  GdkIosKey *key = data;
+  GdkSurface *gdk_surface = (GdkSurface *) key->surface;
+  if (GDK_SURFACE_DESTROYED (gdk_surface))
+    return G_SOURCE_REMOVE;
+
+  GdkIosDisplay *display = (GdkIosDisplay *) gdk_surface_get_display (gdk_surface);
+  GdkDevice *keyboard = display->seat->logical_keyboard;
+  gdk_ios_device_keyboard_maybe_update_surface_focus ((GdkIosDevice *) keyboard, key->surface);
+
+  guint32 time = (guint32) (g_get_monotonic_time () / 1000);
+  GdkTranslatedKey translated = { .keyval = key->keyval, .consumed = 0, .layout = 0, .level = 0 };
+  GdkEvent *press = gdk_key_event_new (GDK_KEY_PRESS, gdk_surface, keyboard, time, key->keyval,
+                                       0, FALSE, &translated, &translated, NULL);
+  gdk_ios_seat_consume_event ((GdkDisplay *) display, press);
+  GdkEvent *release = gdk_key_event_new (GDK_KEY_RELEASE, gdk_surface, keyboard, time, key->keyval,
+                                         0, FALSE, &translated, &translated, NULL);
+  gdk_ios_seat_consume_event ((GdkDisplay *) display, release);
+  return G_SOURCE_REMOVE;
+}
+
+static void
+gdk_ios_events_key_free (gpointer data)
+{
+  GdkIosKey *key = data;
+  g_object_unref (key->surface);
+  g_free (key);
+}
+
+void
+gdk_ios_events_post_text (GdkIosSurface *surface, gunichar ch, guint keyval)
+{
+  GdkIosKey *key = g_new0 (GdkIosKey, 1);
+  key->surface = g_object_ref (surface);
+  key->keyval = keyval != 0 ? keyval : gdk_unicode_to_keyval (ch);
+  gdk_ios_post_to_gtk (gdk_ios_events_key_idle, key, gdk_ios_events_key_free);
+}
