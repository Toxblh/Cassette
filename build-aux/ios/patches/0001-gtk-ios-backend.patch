diff --git a/gtk/gtkimcontextios.c b/gtk/gtkimcontextios.c
new file mode 100644
index 0000000..d710730
--- /dev/null
+++ b/gtk/gtkimcontextios.c
@@ -0,0 +1,224 @@
+/*
+ * GtkIMContextIos: the iOS on-screen keyboard as an input method.
+ *
+ * Text typed on the keyboard is committed straight into the focused
+ * widget; backspace and return become key events so that entries and
+ * text views behave as with a hardware keyboard.
+ *
+ * SPDX-License-Identifier: LGPL-2.1-or-later
+ */
+
+#include "config.h"
+
+#include <string.h>
+
+#include "gtk/gtkimcontextiosprivate.h"
+#include "gtk/gtkimmoduleprivate.h"
+#include "gtk/gtkimcontextsimple.h"
+#include "gtk/gtkprivate.h"
+
+#include "gdk/gdkkeysyms.h"
+#include "gdk/ios/gdkiosdisplay.h"
+#include "gdk/ios/gdkiossurface-private.h"
+#include "gdk/ios/gdkiostextinput-private.h"
+#include "gdk/ios/gdkiosevents-private.h"
+
+#define GTK_IM_CONTEXT_TYPE_IOS (gtk_im_context_ios_get_type ())
+#define GTK_IM_CONTEXT_IOS(obj) (G_TYPE_CHECK_INSTANCE_CAST ((obj), GTK_IM_CONTEXT_TYPE_IOS, GtkIMContextIos))
+#define GTK_IS_IM_CONTEXT_IOS(obj) (G_TYPE_CHECK_INSTANCE_TYPE ((obj), GTK_IM_CONTEXT_TYPE_IOS))
+
+typedef struct
+{
+  GtkIMContextSimpleClass parent_class;
+} GtkIMContextIosClass;
+
+typedef struct
+{
+  GtkIMContextSimple parent;
+
+  GtkWidget *client_widget;
+  gboolean focused;
+} GtkIMContextIos;
+
+G_DEFINE_TYPE_WITH_CODE (GtkIMContextIos, gtk_im_context_ios, GTK_TYPE_IM_CONTEXT_SIMPLE,
+                         gtk_im_module_ensure_extension_point ();
+                         g_io_extension_point_implement (GTK_IM_MODULE_EXTENSION_POINT_NAME,
+                                                         g_define_type_id, "ios", 10))
+
+/* the context that currently owns the keyboard */
+static GtkIMContextIos *gtk_im_context_ios_active = NULL;
+
+static GdkIosSurface *
+gtk_im_context_ios_get_surface (GtkIMContextIos *self)
+{
+  GtkNative *native;
+  if (self->client_widget == NULL)
+    return NULL;
+  native = gtk_widget_get_native (self->client_widget);
+  if (native == NULL)
+    return NULL;
+  GdkSurface *surface = gtk_native_get_surface (native);
+  return GDK_IS_IOS_SURFACE (surface) ? (GdkIosSurface *) surface : NULL;
+}
+
+static void
+gtk_im_context_ios_send_key (GtkIMContextIos *self, guint keyval)
+{
+  GdkIosSurface *surface = gtk_im_context_ios_get_surface (self);
+  if (surface != NULL)
+    gdk_ios_events_post_text (surface, 0, keyval);
+}
+
+static void
+gtk_im_context_ios_on_insert (const char *text, gpointer user_data)
+{
+  GtkIMContextIos *self = user_data;
+  if (self->focused)
+    g_signal_emit_by_name (self, "commit", text);
+}
+
+static void
+gtk_im_context_ios_on_delete (gpointer user_data)
+{
+  GtkIMContextIos *self = user_data;
+  if (self->focused)
+    gtk_im_context_ios_send_key (self, GDK_KEY_BackSpace);
+}
+
+static void
+gtk_im_context_ios_on_enter (gpointer user_data)
+{
+  GtkIMContextIos *self = user_data;
+  if (self->focused)
+    gtk_im_context_ios_send_key (self, GDK_KEY_Return);
+}
+
+static const GdkIosTextInputHandlers gtk_im_context_ios_handlers = {
+  .insert = gtk_im_context_ios_on_insert,
+  .delete_backward = gtk_im_context_ios_on_delete,
+  .enter = gtk_im_context_ios_on_enter,
+};
+
+static void
+gtk_im_context_ios_update_keyboard (GtkIMContextIos *self)
+{
+  if (self->focused)
+    {
+      GtkInputPurpose purpose = GTK_INPUT_PURPOSE_FREE_FORM;
+      GtkInputHints hints = GTK_INPUT_HINT_NONE;
+      g_object_get (self, "input-purpose", &purpose, "input-hints", &hints, NULL);
+
+      GdkIosKeyboardType type = GDK_IOS_KEYBOARD_DEFAULT;
+      gboolean secure = FALSE;
+      switch (purpose)
+        {
+        case GTK_INPUT_PURPOSE_DIGITS:
+        case GTK_INPUT_PURPOSE_PIN:
+          type = GDK_IOS_KEYBOARD_NUMBER;
+          break;
+        case GTK_INPUT_PURPOSE_NUMBER:
+          type = GDK_IOS_KEYBOARD_DECIMAL;
+          break;
+        case GTK_INPUT_PURPOSE_PHONE:
+          type = GDK_IOS_KEYBOARD_PHONE;
+          break;
+        case GTK_INPUT_PURPOSE_URL:
+          type = GDK_IOS_KEYBOARD_URL;
+          break;
+        case GTK_INPUT_PURPOSE_EMAIL:
+          type = GDK_IOS_KEYBOARD_EMAIL;
+          break;
+        case GTK_INPUT_PURPOSE_PASSWORD:
+          secure = TRUE;
+          break;
+        default:
+          break;
+        }
+      if (purpose == GTK_INPUT_PURPOSE_PIN)
+        secure = TRUE;
+      gboolean autocorrect = (hints & GTK_INPUT_HINT_SPELLCHECK) != 0 && (hints & GTK_INPUT_HINT_NO_SPELLCHECK) == 0;
+
+      gtk_im_context_ios_active = self;
+      gdk_ios_text_input_set_handlers (&gtk_im_context_ios_handlers, self);
+      gdk_ios_text_input_show (type, secure, autocorrect);
+    }
+  else if (gtk_im_context_ios_active == self)
+    {
+      gtk_im_context_ios_active = NULL;
+      gdk_ios_text_input_set_handlers (NULL, NULL);
+      gdk_ios_text_input_hide ();
+    }
+}
+
+static void
+gtk_im_context_ios_set_client_widget (GtkIMContext *context, GtkWidget *widget)
+{
+  GtkIMContextIos *self = GTK_IM_CONTEXT_IOS (context);
+  g_clear_weak_pointer (&self->client_widget);
+  self->client_widget = widget;
+  if (widget != NULL)
+    g_object_add_weak_pointer ((GObject *) self->client_widget, (gpointer *) &self->client_widget);
+  if (GTK_IM_CONTEXT_CLASS (gtk_im_context_ios_parent_class)->set_client_widget)
+    GTK_IM_CONTEXT_CLASS (gtk_im_context_ios_parent_class)->set_client_widget (context, widget);
+}
+
+static void
+gtk_im_context_ios_focus_in (GtkIMContext *context)
+{
+  GtkIMContextIos *self = GTK_IM_CONTEXT_IOS (context);
+  self->focused = TRUE;
+  gtk_im_context_ios_update_keyboard (self);
+  if (GTK_IM_CONTEXT_CLASS (gtk_im_context_ios_parent_class)->focus_in)
+    GTK_IM_CONTEXT_CLASS (gtk_im_context_ios_parent_class)->focus_in (context);
+}
+
+static void
+gtk_im_context_ios_focus_out (GtkIMContext *context)
+{
+  GtkIMContextIos *self = GTK_IM_CONTEXT_IOS (context);
+  self->focused = FALSE;
+  gtk_im_context_ios_update_keyboard (self);
+  if (GTK_IM_CONTEXT_CLASS (gtk_im_context_ios_parent_class)->focus_out)
+    GTK_IM_CONTEXT_CLASS (gtk_im_context_ios_parent_class)->focus_out (context);
+}
+
+static gboolean
+gtk_im_context_ios_activate_osk (GtkIMContext *context, GdkEvent *event)
+{
+  GtkIMContextIos *self = GTK_IM_CONTEXT_IOS (context);
+  gtk_im_context_ios_update_keyboard (self);
+  return self->focused;
+}
+
+static void
+gtk_im_context_ios_finalize (GObject *object)
+{
+  GtkIMContextIos *self = (GtkIMContextIos *) object;
+  if (gtk_im_context_ios_active == self)
+    {
+      gtk_im_context_ios_active = NULL;
+      gdk_ios_text_input_set_handlers (NULL, NULL);
+      gdk_ios_text_input_hide ();
+    }
+  g_clear_weak_pointer (&self->client_widget);
+  G_OBJECT_CLASS (gtk_im_context_ios_parent_class)->finalize (object);
+}
+
+static void
+gtk_im_context_ios_class_init (GtkIMContextIosClass *klass)
+{
+  GObjectClass *object_class = G_OBJECT_CLASS (klass);
+  GtkIMContextClass *context_class = GTK_IM_CONTEXT_CLASS (klass);
+
+  object_class->finalize = gtk_im_context_ios_finalize;
+  context_class->set_client_widget = gtk_im_context_ios_set_client_widget;
+  context_class->focus_in = gtk_im_context_ios_focus_in;
+  context_class->focus_out = gtk_im_context_ios_focus_out;
+  context_class->activate_osk_with_event = gtk_im_context_ios_activate_osk;
+}
+
+static void
+gtk_im_context_ios_init (GtkIMContextIos *self)
+{
+  self->focused = FALSE;
+}
