diff --git a/gdk/ios/gdkiostextinput-private.h b/gdk/ios/gdkiostextinput-private.h
new file mode 100644
index 0000000..689b718
--- /dev/null
+++ b/gdk/ios/gdkiostextinput-private.h
@@ -0,0 +1,42 @@
+#pragma once
+
+#include <gdk/gdk.h>
+
+G_BEGIN_DECLS
+
+/*
+ * The on-screen keyboard. One hidden UIView that is the first responder
+ * while a GTK text widget has focus; what the user types is queued to the
+ * GTK thread and handed to the active handlers.
+ */
+
+typedef struct
+{
+  void (*insert) (const char *text, gpointer user_data);
+  void (*delete_backward) (gpointer user_data);
+  void (*enter) (gpointer user_data);
+} GdkIosTextInputHandlers;
+
+/* GTK thread. @handlers/@user_data stay active until the next call. */
+void gdk_ios_text_input_set_handlers (const GdkIosTextInputHandlers *handlers, gpointer user_data);
+
+typedef enum
+{
+  GDK_IOS_KEYBOARD_DEFAULT,
+  GDK_IOS_KEYBOARD_NUMBER,
+  GDK_IOS_KEYBOARD_DECIMAL,
+  GDK_IOS_KEYBOARD_PHONE,
+  GDK_IOS_KEYBOARD_URL,
+  GDK_IOS_KEYBOARD_EMAIL,
+} GdkIosKeyboardType;
+
+/* Any thread: show the keyboard with these traits / hide it. */
+void gdk_ios_text_input_show (GdkIosKeyboardType type, gboolean secure, gboolean autocorrect);
+void gdk_ios_text_input_hide (void);
+
+#ifdef __OBJC__
+#import <UIKit/UIKit.h>
+UIView *gdk_ios_text_input_get_view (void);
+#endif
+
+G_END_DECLS
diff --git a/gdk/ios/gdkiostextinput.c b/gdk/ios/gdkiostextinput.c
new file mode 100644
index 0000000..b400cd0
--- /dev/null
+++ b/gdk/ios/gdkiostextinput.c
@@ -0,0 +1,164 @@
+/* GDK iOS backend: the on-screen keyboard. SPDX-License-Identifier: LGPL-2.1-or-later */
+
+#include "config.h"
+
+#import <UIKit/UIKit.h>
+
+#include "gdkiosruntime-private.h"
+
+#include "gdkiostextinput-private.h"
+
+static GdkIosTextInputHandlers gdk_ios_handlers = { 0 };
+static gpointer gdk_ios_handlers_data = NULL;
+
+/* ── GTK thread side ────────────────────────────────────────────────── */
+
+void
+gdk_ios_text_input_set_handlers (const GdkIosTextInputHandlers *handlers, gpointer user_data)
+{
+  if (handlers != NULL)
+    gdk_ios_handlers = *handlers;
+  else
+    memset (&gdk_ios_handlers, 0, sizeof gdk_ios_handlers);
+  gdk_ios_handlers_data = user_data;
+}
+
+static gboolean
+insert_idle (gpointer data)
+{
+  if (gdk_ios_handlers.insert != NULL)
+    gdk_ios_handlers.insert ((const char *) data, gdk_ios_handlers_data);
+  return G_SOURCE_REMOVE;
+}
+
+static gboolean
+delete_idle (gpointer data)
+{
+  if (gdk_ios_handlers.delete_backward != NULL)
+    gdk_ios_handlers.delete_backward (gdk_ios_handlers_data);
+  return G_SOURCE_REMOVE;
+}
+
+static gboolean
+enter_idle (gpointer data)
+{
+  if (gdk_ios_handlers.enter != NULL)
+    gdk_ios_handlers.enter (gdk_ios_handlers_data);
+  return G_SOURCE_REMOVE;
+}
+
+/* ── the responder (main thread) ────────────────────────────────────── */
+
+@interface GdkIosTextInputView : UIView <UIKeyInput>
+@property (nonatomic, assign) UIKeyboardType gdkKeyboardType;
+@property (nonatomic, assign) BOOL gdkSecure;
+@property (nonatomic, assign) UITextAutocorrectionType gdkAutocorrection;
+@end
+
+@implementation GdkIosTextInputView
+
+- (BOOL)canBecomeFirstResponder
+{
+  return YES;
+}
+
+- (BOOL)hasText
+{
+  /* Pretend there is always text so deleteBackward keeps arriving. */
+  return YES;
+}
+
+- (void)insertText:(NSString *)text
+{
+  if ([text isEqualToString:@"\n"])
+    {
+      gdk_ios_post_to_gtk (enter_idle, NULL, NULL);
+      return;
+    }
+  gdk_ios_post_to_gtk (insert_idle, g_strdup (text.UTF8String), g_free);
+}
+
+- (void)deleteBackward
+{
+  gdk_ios_post_to_gtk (delete_idle, NULL, NULL);
+}
+
+- (UIKeyboardType)keyboardType
+{
+  return self.gdkKeyboardType;
+}
+
+- (BOOL)isSecureTextEntry
+{
+  return self.gdkSecure;
+}
+
+- (UITextAutocorrectionType)autocorrectionType
+{
+  return self.gdkAutocorrection;
+}
+
+- (UITextAutocapitalizationType)autocapitalizationType
+{
+  return UITextAutocapitalizationTypeNone;
+}
+
+- (UIReturnKeyType)returnKeyType
+{
+  return UIReturnKeyDefault;
+}
+
+@end
+
+static GdkIosTextInputView *gdk_ios_text_input_view = nil;
+
+UIView *
+gdk_ios_text_input_get_view (void)
+{
+  if (gdk_ios_text_input_view == nil)
+    {
+      gdk_ios_text_input_view = [[GdkIosTextInputView alloc] initWithFrame:CGRectZero];
+      gdk_ios_text_input_view.hidden = YES;
+      [gdk_ios_runtime_get_root_view () addSubview:gdk_ios_text_input_view];
+    }
+  return gdk_ios_text_input_view;
+}
+
+void
+gdk_ios_text_input_show (GdkIosKeyboardType type, gboolean secure, gboolean autocorrect)
+{
+  gdk_ios_run_on_main_async (^{
+    GdkIosTextInputView *view = (GdkIosTextInputView *) gdk_ios_text_input_get_view ();
+    UIKeyboardType kb = UIKeyboardTypeDefault;
+    switch (type)
+      {
+      case GDK_IOS_KEYBOARD_NUMBER: kb = UIKeyboardTypeNumberPad; break;
+      case GDK_IOS_KEYBOARD_DECIMAL: kb = UIKeyboardTypeDecimalPad; break;
+      case GDK_IOS_KEYBOARD_PHONE: kb = UIKeyboardTypePhonePad; break;
+      case GDK_IOS_KEYBOARD_URL: kb = UIKeyboardTypeURL; break;
+      case GDK_IOS_KEYBOARD_EMAIL: kb = UIKeyboardTypeEmailAddress; break;
+      default: break;
+      }
+    BOOL changed = view.gdkKeyboardType != kb || view.gdkSecure != (BOOL) secure ||
+                   view.gdkAutocorrection != (autocorrect ? UITextAutocorrectionTypeDefault : UITextAutocorrectionTypeNo);
+    view.gdkKeyboardType = kb;
+    view.gdkSecure = secure;
+    view.gdkAutocorrection = autocorrect ? UITextAutocorrectionTypeDefault : UITextAutocorrectionTypeNo;
+    if (view.isFirstResponder)
+      {
+        if (changed)
+          [view reloadInputViews];
+      }
+    else
+      [view becomeFirstResponder];
+  });
+}
+
+void
+gdk_ios_text_input_hide (void)
+{
+  gdk_ios_run_on_main_async (^{
+    if (gdk_ios_text_input_view != nil && gdk_ios_text_input_view.isFirstResponder)
+      [gdk_ios_text_input_view resignFirstResponder];
+  });
+}
