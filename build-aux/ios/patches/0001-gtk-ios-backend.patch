diff --git a/gdk/ios/gdkiosclipboard.c b/gdk/ios/gdkiosclipboard.c
new file mode 100644
index 0000000..3fb6f9d
--- /dev/null
+++ b/gdk/ios/gdkiosclipboard.c
@@ -0,0 +1,201 @@
+/* GDK iOS backend: clipboard backed by UIPasteboard.
+ * SPDX-License-Identifier: LGPL-2.1-or-later
+ */
+
+#include "config.h"
+
+#import <UIKit/UIKit.h>
+
+#include "gdkiosclipboard-private.h"
+#include "gdkiosruntime-private.h"
+
+struct _GdkIosClipboard
+{
+  GdkClipboard parent_instance;
+
+  NSInteger last_change_count;
+  guint check_source;
+};
+
+G_DEFINE_TYPE (GdkIosClipboard, _gdk_ios_clipboard, GDK_TYPE_CLIPBOARD)
+
+static GdkContentFormats *
+gdk_ios_clipboard_text_formats (void)
+{
+  /* Advertise text unconditionally. UIPasteboard has no way to ask
+   * whether it holds text without triggering the iOS paste permission
+   * alert, and that must only happen when the user really pastes. */
+  return gdk_content_formats_new_for_gtype (G_TYPE_STRING);
+}
+
+static void
+gdk_ios_clipboard_claim_remote_text (GdkIosClipboard *self)
+{
+  GdkContentFormats *formats = gdk_ios_clipboard_text_formats ();
+
+  self->last_change_count = [UIPasteboard generalPasteboard].changeCount;
+  gdk_clipboard_claim_remote (GDK_CLIPBOARD (self), formats);
+  gdk_content_formats_unref (formats);
+}
+
+/* Poll the pasteboard's change counter. Reading it is free and silent,
+ * unlike reading the contents, so we only need to know whether another
+ * app took ownership and our local contents are stale. */
+static gboolean
+gdk_ios_clipboard_check_change (gpointer data)
+{
+  GdkIosClipboard *self = data;
+
+  if ([UIPasteboard generalPasteboard].changeCount != self->last_change_count)
+    {
+      g_debug ("iOS clipboard: pasteboard changed externally, claiming remote text");
+      gdk_ios_clipboard_claim_remote_text (self);
+    }
+
+  return G_SOURCE_CONTINUE;
+}
+
+static void
+gdk_ios_clipboard_read_async (GdkClipboard       *clipboard,
+                              GdkContentFormats  *formats,
+                              int                 io_priority,
+                              GCancellable       *cancellable,
+                              GAsyncReadyCallback callback,
+                              gpointer            user_data)
+{
+  GTask *task;
+  __block char *text = NULL;
+
+  task = g_task_new (clipboard, cancellable, callback, user_data);
+  g_task_set_priority (task, io_priority);
+  g_task_set_source_tag (task, gdk_ios_clipboard_read_async);
+
+  gdk_ios_run_on_main_sync (^{
+    NSString *string = [UIPasteboard generalPasteboard].string;
+    if (string != nil)
+      text = g_strdup (string.UTF8String);
+  });
+
+  if (text == NULL)
+    {
+      g_debug ("iOS clipboard: pasteboard holds no text");
+      g_task_return_new_error (task, G_IO_ERROR, G_IO_ERROR_NOT_FOUND,
+                               "The pasteboard does not contain text");
+    }
+  else
+    {
+      GInputStream *stream = g_memory_input_stream_new_from_data (text, -1, g_free);
+      g_debug ("iOS clipboard: read %zu bytes of text", strlen (text));
+      g_task_set_task_data (task, (gpointer) g_intern_string ("text/plain;charset=utf-8"), NULL);
+      g_task_return_pointer (task, stream, g_object_unref);
+    }
+
+  g_object_unref (task);
+}
+
+static GInputStream *
+gdk_ios_clipboard_read_finish (GdkClipboard  *clipboard,
+                               GAsyncResult  *result,
+                               const char   **out_mime_type,
+                               GError       **error)
+{
+  g_return_val_if_fail (g_task_is_valid (result, clipboard), NULL);
+
+  if (out_mime_type != NULL)
+    *out_mime_type = g_task_get_task_data (G_TASK (result));
+
+  return g_task_propagate_pointer (G_TASK (result), error);
+}
+
+static gboolean
+gdk_ios_clipboard_claim (GdkClipboard       *clipboard,
+                         GdkContentFormats  *formats,
+                         gboolean            local,
+                         GdkContentProvider *content)
+{
+  GdkIosClipboard *self = (GdkIosClipboard *) clipboard;
+  gboolean ret;
+
+  ret = GDK_CLIPBOARD_CLASS (_gdk_ios_clipboard_parent_class)->claim (clipboard, formats, local, content);
+
+  if (local && content != NULL)
+    {
+      GValue value = G_VALUE_INIT;
+      GError *error = NULL;
+
+      g_value_init (&value, G_TYPE_STRING);
+      if (gdk_content_provider_get_value (content, &value, &error))
+        {
+          const char *text = g_value_get_string (&value);
+
+          if (text != NULL)
+            {
+              g_debug ("iOS clipboard: copied %zu bytes to UIPasteboard", strlen (text));
+              gdk_ios_run_on_main_sync (^{
+                [UIPasteboard generalPasteboard].string = [NSString stringWithUTF8String:text];
+              });
+              self->last_change_count = [UIPasteboard generalPasteboard].changeCount;
+            }
+        }
+      else
+        {
+          g_debug ("iOS clipboard: provider is not text: %s",
+                   error != NULL ? error->message : "unknown error");
+          g_clear_error (&error);
+        }
+
+      g_value_unset (&value);
+    }
+
+  return ret;
+}
+
+static void
+gdk_ios_clipboard_finalize (GObject *object)
+{
+  GdkIosClipboard *self = (GdkIosClipboard *) object;
+
+  if (self->check_source != 0)
+    {
+      g_source_remove (self->check_source);
+      self->check_source = 0;
+    }
+
+  G_OBJECT_CLASS (_gdk_ios_clipboard_parent_class)->finalize (object);
+}
+
+static void
+_gdk_ios_clipboard_class_init (GdkIosClipboardClass *klass)
+{
+  GObjectClass *object_class = G_OBJECT_CLASS (klass);
+  GdkClipboardClass *clipboard_class = GDK_CLIPBOARD_CLASS (klass);
+
+  object_class->finalize = gdk_ios_clipboard_finalize;
+
+  clipboard_class->claim = gdk_ios_clipboard_claim;
+  clipboard_class->read_async = gdk_ios_clipboard_read_async;
+  clipboard_class->read_finish = gdk_ios_clipboard_read_finish;
+}
+
+static void
+_gdk_ios_clipboard_init (GdkIosClipboard *self)
+{
+}
+
+GdkClipboard *
+_gdk_ios_clipboard_new (GdkIosDisplay *display)
+{
+  GdkIosClipboard *self;
+
+  g_return_val_if_fail (GDK_IS_IOS_DISPLAY (display), NULL);
+
+  self = g_object_new (GDK_TYPE_IOS_CLIPBOARD,
+                       "display", display,
+                       NULL);
+
+  gdk_ios_clipboard_claim_remote_text (self);
+  self->check_source = g_timeout_add (500, gdk_ios_clipboard_check_change, self);
+  g_debug ("iOS clipboard: ready (pasteboard changeCount %ld)", (long) self->last_change_count);
+
+  return GDK_CLIPBOARD (self);
+}
