diff --git a/gdk/ios/gdkioscairocontext.c b/gdk/ios/gdkioscairocontext.c
new file mode 100644
index 0000000..c60b5e3
--- /dev/null
+++ b/gdk/ios/gdkioscairocontext.c
@@ -0,0 +1,179 @@
+/*
+ * GDK iOS backend: cairo drawing into a CALayer.
+ *
+ * GTK paints into a persistent cairo image surface on the GTK thread;
+ * after each frame a copy of it becomes a CGImage that is handed to the
+ * view's layer on the main thread.
+ *
+ * SPDX-License-Identifier: LGPL-2.1-or-later
+ */
+
+#include "config.h"
+
+#import <UIKit/UIKit.h>
+#import <QuartzCore/QuartzCore.h>
+
+#include <math.h>
+#include <string.h>
+#include <cairo.h>
+
+#include "gdkiosruntime-private.h"
+#include "gdkiossurface-private.h"
+
+#include "gdkioscairocontext-private.h"
+
+struct _GdkIosCairoContext
+{
+  GdkCairoContext parent_instance;
+
+  cairo_surface_t *backing;
+  int backing_width;
+  int backing_height;
+  gboolean in_frame;
+};
+
+struct _GdkIosCairoContextClass
+{
+  GdkCairoContextClass parent_class;
+};
+
+G_DEFINE_TYPE (GdkIosCairoContext, gdk_ios_cairo_context, GDK_TYPE_CAIRO_CONTEXT)
+
+static cairo_t *
+gdk_ios_cairo_context_cairo_create (GdkCairoContext *cairo_context)
+{
+  GdkIosCairoContext *self = GDK_IOS_CAIRO_CONTEXT (cairo_context);
+  return self->backing != NULL ? cairo_create (self->backing) : NULL;
+}
+
+static void
+gdk_ios_cairo_context_begin_frame (GdkDrawContext *draw_context,
+                                   gpointer        context_data,
+                                   cairo_region_t *region,
+                                   GdkColorState **out_color_state,
+                                   GdkMemoryDepth *out_depth)
+{
+  GdkIosCairoContext *self = (GdkIosCairoContext *) draw_context;
+  GdkSurface *surface = gdk_draw_context_get_surface (draw_context);
+  GdkIosSurface *impl = (GdkIosSurface *) surface;
+
+  double scale = impl->cfg.scale > 0 ? impl->cfg.scale : 1.0;
+  int width = (int) ceil (surface->width * scale);
+  int height = (int) ceil (surface->height * scale);
+
+  if (self->backing == NULL || self->backing_width != width || self->backing_height != height)
+    {
+      g_clear_pointer (&self->backing, cairo_surface_destroy);
+      /* No device scale here: GdkCairoContext applies cairo_scale() itself
+       * and expects the region and the buffer in device pixels. */
+      self->backing = cairo_image_surface_create (CAIRO_FORMAT_ARGB32, MAX (width, 1), MAX (height, 1));
+      self->backing_width = width;
+      self->backing_height = height;
+
+      cairo_rectangle_int_t all = { 0, 0, width, height };
+      cairo_region_union_rectangle (region, &all);
+    }
+
+  self->in_frame = TRUE;
+  *out_color_state = GDK_COLOR_STATE_SRGB;
+  *out_depth = gdk_color_state_get_depth (GDK_COLOR_STATE_SRGB);
+}
+
+static void
+gdk_ios_cairo_context_release_data (void *info, const void *data, size_t size)
+{
+  g_free ((gpointer) data);
+}
+
+static void
+gdk_ios_cairo_context_end_frame (GdkDrawContext *draw_context,
+                                 gpointer        context_data,
+                                 cairo_region_t *painted)
+{
+  GdkIosCairoContext *self = (GdkIosCairoContext *) draw_context;
+  GdkSurface *surface = gdk_draw_context_get_surface (draw_context);
+  GdkIosSurface *impl = (GdkIosSurface *) surface;
+
+  self->in_frame = FALSE;
+  if (self->backing == NULL || impl->view == NULL)
+    return;
+
+  cairo_surface_flush (self->backing);
+
+  cairo_rectangle_int_t extents;
+  cairo_region_get_extents (painted, &extents);
+  g_debug ("iOS cairo: frame for %p painted %dx%d at (%d|%d)", impl,
+           extents.width, extents.height, extents.x, extents.y);
+
+  int width = cairo_image_surface_get_width (self->backing);
+  int height = cairo_image_surface_get_height (self->backing);
+  int stride = cairo_image_surface_get_stride (self->backing);
+  size_t size = (size_t) stride * height;
+
+  guchar *copy = g_malloc (size);
+  memcpy (copy, cairo_image_surface_get_data (self->backing), size);
+
+  CGDataProviderRef provider = CGDataProviderCreateWithData (NULL, copy, size, gdk_ios_cairo_context_release_data);
+  CGColorSpaceRef colorspace = CGColorSpaceCreateDeviceRGB ();
+  /* cairo ARGB32 is premultiplied BGRA in memory on little-endian */
+  CGImageRef image = CGImageCreate (width, height, 8, 32, stride, colorspace,
+                                    kCGBitmapByteOrder32Little | kCGImageAlphaPremultipliedFirst,
+                                    provider, NULL, false, kCGRenderingIntentDefault);
+  CGColorSpaceRelease (colorspace);
+  CGDataProviderRelease (provider);
+
+  UIView *view = [(UIView *) impl->view retain];
+  double scale = impl->cfg.scale;
+  gdk_ios_run_on_main_async (^{
+    [CATransaction begin];
+    [CATransaction setDisableActions:YES];
+    view.layer.contentsScale = scale;
+    view.layer.contents = (id) image;
+    [CATransaction commit];
+    CGImageRelease (image);
+    [view release];
+  });
+}
+
+static void
+gdk_ios_cairo_context_empty_frame (GdkDrawContext *draw_context)
+{
+}
+
+static void
+gdk_ios_cairo_context_surface_resized (GdkDrawContext *draw_context)
+{
+  GdkIosCairoContext *self = (GdkIosCairoContext *) draw_context;
+  if (!self->in_frame)
+    g_clear_pointer (&self->backing, cairo_surface_destroy);
+}
+
+static void
+gdk_ios_cairo_context_dispose (GObject *object)
+{
+  GdkIosCairoContext *self = (GdkIosCairoContext *) object;
+  g_clear_pointer (&self->backing, cairo_surface_destroy);
+  G_OBJECT_CLASS (gdk_ios_cairo_context_parent_class)->dispose (object);
+}
+
+static void
+gdk_ios_cairo_context_class_init (GdkIosCairoContextClass *klass)
+{
+  GObjectClass *object_class = G_OBJECT_CLASS (klass);
+  GdkDrawContextClass *draw_context_class = GDK_DRAW_CONTEXT_CLASS (klass);
+  GdkCairoContextClass *cairo_context_class = GDK_CAIRO_CONTEXT_CLASS (klass);
+
+  object_class->dispose = gdk_ios_cairo_context_dispose;
+
+  draw_context_class->begin_frame = gdk_ios_cairo_context_begin_frame;
+  draw_context_class->end_frame = gdk_ios_cairo_context_end_frame;
+  draw_context_class->empty_frame = gdk_ios_cairo_context_empty_frame;
+  draw_context_class->surface_resized = gdk_ios_cairo_context_surface_resized;
+
+  cairo_context_class->cairo_create = gdk_ios_cairo_context_cairo_create;
+}
+
+static void
+gdk_ios_cairo_context_init (GdkIosCairoContext *self)
+{
+}
