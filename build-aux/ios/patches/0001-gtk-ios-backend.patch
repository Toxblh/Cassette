diff --git a/gdk/ios/gdkiosdisplay.c b/gdk/ios/gdkiosdisplay.c
new file mode 100644
index 0000000..1b7e0b7
--- /dev/null
+++ b/gdk/ios/gdkiosdisplay.c
@@ -0,0 +1,227 @@
+/* GDK iOS backend: GdkDisplay. SPDX-License-Identifier: LGPL-2.1-or-later */
+
+#include "config.h"
+
+#import <UIKit/UIKit.h>
+
+#include "gdkdisplayprivate.h"
+#include "gdkclipboardprivate.h"
+#include "gdkglcontextprivate.h"
+
+#include "gdkiosruntime-private.h"
+#include "gdkiosmonitor-private.h"
+#include "gdkiossurface-private.h"
+#include "gdkiostoplevel-private.h"
+#include "gdkiospopup-private.h"
+#include "gdkioscairocontext-private.h"
+#include "gdkiosseat-private.h"
+
+#include "gdkiosdisplay-private.h"
+
+#include "gtk/gtkenums.h"
+
+G_DEFINE_TYPE (GdkIosDisplay, gdk_ios_display, GDK_TYPE_DISPLAY)
+
+static GdkIosDisplay *gdk_ios_display_instance = NULL;
+
+static void
+gdk_ios_display_finalize (GObject *object)
+{
+  GdkIosDisplay *self = (GdkIosDisplay *) object;
+  GdkDisplay *display = (GdkDisplay *) self;
+
+  g_clear_object (&display->clipboard);
+  g_clear_object (&self->monitors);
+  g_clear_object (&self->monitor);
+  g_clear_object (&self->seat);
+  g_clear_object (&self->keymap);
+
+  G_OBJECT_CLASS (gdk_ios_display_parent_class)->finalize (object);
+}
+
+static const char *
+gdk_ios_display_get_name (GdkDisplay *display)
+{
+  return "IosDisplay";
+}
+
+static void
+gdk_ios_display_nop (GdkDisplay *display)
+{
+}
+
+static GdkGLContext *
+gdk_ios_display_init_gl (GdkDisplay *display, GError **error)
+{
+  g_set_error_literal (error, GDK_GL_ERROR, GDK_GL_ERROR_NOT_AVAILABLE,
+                       "OpenGL is not available in the iOS backend yet");
+  return NULL;
+}
+
+static gulong
+gdk_ios_display_get_next_serial (GdkDisplay *display)
+{
+  return 0;
+}
+
+static void
+gdk_ios_display_notify_startup_complete (GdkDisplay *display, const char *startup_id)
+{
+}
+
+static GdkKeymap *
+gdk_ios_display_get_keymap (GdkDisplay *display)
+{
+  return ((GdkIosDisplay *) display)->keymap;
+}
+
+static GdkSeat *
+gdk_ios_display_get_default_seat (GdkDisplay *display)
+{
+  return (GdkSeat *) ((GdkIosDisplay *) display)->seat;
+}
+
+static GListModel *
+gdk_ios_display_get_monitors (GdkDisplay *display)
+{
+  return G_LIST_MODEL (((GdkIosDisplay *) display)->monitors);
+}
+
+static GdkMonitor *
+gdk_ios_display_get_monitor_at_surface (GdkDisplay *display, GdkSurface *surface)
+{
+  return ((GdkIosDisplay *) display)->monitor;
+}
+
+static gboolean
+gdk_ios_display_get_setting (GdkDisplay *display, const char *name, GValue *value)
+{
+  GdkIosDisplay *self = (GdkIosDisplay *) display;
+
+  if (g_strcmp0 (name, "gtk-application-prefer-dark-theme") == 0)
+    {
+      g_value_set_boolean (value, self->dark);
+      return TRUE;
+    }
+  else if (g_strcmp0 (name, "gtk-interface-color-scheme") == 0)
+    {
+      g_value_set_enum (value, self->dark ? GTK_INTERFACE_COLOR_SCHEME_DARK : GTK_INTERFACE_COLOR_SCHEME_LIGHT);
+      return TRUE;
+    }
+  else if (g_strcmp0 (name, "gtk-decoration-layout") == 0)
+    {
+      g_value_set_static_string (value, ":");
+      return TRUE;
+    }
+  else if (g_strcmp0 (name, "gtk-shell-shows-app-menu") == 0 ||
+           g_strcmp0 (name, "gtk-shell-shows-menubar") == 0)
+    {
+      g_value_set_boolean (value, FALSE);
+      return TRUE;
+    }
+  return FALSE;
+}
+
+static void
+gdk_ios_display_class_init (GdkIosDisplayClass *klass)
+{
+  GObjectClass *object_class = G_OBJECT_CLASS (klass);
+  GdkDisplayClass *display_class = GDK_DISPLAY_CLASS (klass);
+
+  object_class->finalize = gdk_ios_display_finalize;
+
+  display_class->toplevel_type = GDK_TYPE_IOS_TOPLEVEL;
+  display_class->popup_type = GDK_TYPE_IOS_POPUP;
+  display_class->cairo_context_type = GDK_TYPE_IOS_CAIRO_CONTEXT;
+  display_class->vk_context_type = G_TYPE_NONE;
+  display_class->vk_extension_name = NULL;
+
+  display_class->get_name = gdk_ios_display_get_name;
+  display_class->beep = gdk_ios_display_nop;
+  display_class->sync = gdk_ios_display_nop;
+  display_class->flush = gdk_ios_display_nop;
+  display_class->queue_events = gdk_ios_display_nop;
+  display_class->init_gl = gdk_ios_display_init_gl;
+  display_class->get_next_serial = gdk_ios_display_get_next_serial;
+  display_class->notify_startup_complete = gdk_ios_display_notify_startup_complete;
+  display_class->get_keymap = gdk_ios_display_get_keymap;
+  display_class->get_default_seat = gdk_ios_display_get_default_seat;
+  display_class->get_monitors = gdk_ios_display_get_monitors;
+  display_class->get_monitor_at_surface = gdk_ios_display_get_monitor_at_surface;
+  display_class->get_setting = gdk_ios_display_get_setting;
+}
+
+static void
+gdk_ios_display_init (GdkIosDisplay *self)
+{
+  GdkDisplay *display = (GdkDisplay *) self;
+
+  display->clipboard = gdk_clipboard_new (display);
+
+  self->monitors = g_list_store_new (GDK_TYPE_IOS_MONITOR);
+  self->seat = gdk_ios_seat_new (display);
+  gdk_display_add_seat (display, (GdkSeat *) self->seat);
+  self->keymap = g_object_new (GDK_TYPE_IOS_KEYMAP, NULL);
+
+  gdk_display_set_composited (display, TRUE);
+  gdk_display_set_input_shapes (display, TRUE);
+  gdk_display_set_rgba (display, TRUE);
+  gdk_display_set_shadow_width (display, FALSE);
+}
+
+GdkDisplay *
+_gdk_ios_display_open (const char *display_name)
+{
+  if (gdk_ios_display_instance != NULL)
+    return NULL;
+
+  if (!gdk_ios_runtime_is_ready ())
+    {
+      g_warning ("Cannot open the iOS display before UIKit has launched; use gdk_ios_main()");
+      return NULL;
+    }
+
+  GdkIosDisplay *self = g_object_new (GDK_TYPE_IOS_DISPLAY, NULL);
+  gdk_ios_display_instance = self;
+  g_object_add_weak_pointer (G_OBJECT (self), (gpointer *) &gdk_ios_display_instance);
+
+  __block GdkRectangle bounds;
+  __block double scale = 1;
+  __block int refresh = 60000;
+  __block gboolean dark = FALSE;
+  gdk_ios_run_on_main_sync (^{
+    UIScreen *screen = [UIScreen mainScreen];
+    CGRect b = screen.bounds;
+    bounds = (GdkRectangle){ (int) b.origin.x, (int) b.origin.y, (int) ceil (b.size.width), (int) ceil (b.size.height) };
+    scale = screen.scale;
+    refresh = (int) screen.maximumFramesPerSecond * 1000;
+    dark = gdk_ios_runtime_get_root_view ().traitCollection.userInterfaceStyle == UIUserInterfaceStyleDark;
+  });
+  self->scale = scale;
+  self->dark = dark;
+  self->monitor = gdk_ios_monitor_new ((GdkDisplay *) self);
+  gdk_ios_monitor_update ((GdkIosMonitor *) self->monitor, &bounds, scale, refresh);
+  g_list_store_append (self->monitors, self->monitor);
+
+  g_debug ("iOS display: %dx%d points, scale %.1f, %d mHz, dark %d",
+           bounds.width, bounds.height, scale, refresh, dark);
+
+  gdk_display_emit_opened (GDK_DISPLAY (self));
+  return GDK_DISPLAY (self);
+}
+
+GdkIosDisplay *
+gdk_ios_display_get_instance (void)
+{
+  return gdk_ios_display_instance;
+}
+
+void
+gdk_ios_display_set_dark (GdkIosDisplay *self, gboolean dark)
+{
+  if (self->dark == dark)
+    return;
+  self->dark = dark;
+  gdk_display_setting_changed ((GdkDisplay *) self, "gtk-application-prefer-dark-theme");
+  gdk_display_setting_changed ((GdkDisplay *) self, "gtk-interface-color-scheme");
+}
