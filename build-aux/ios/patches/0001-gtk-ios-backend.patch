@@ -0,0 +1,357 @@
+/* GDK iOS backend: seat, devices and a unicode keymap. SPDX-License-Identifier: LGPL-2.1-or-later */
+
+#include "config.h"
+
+#import <UIKit/UIKit.h>
+
+#include "gdkdisplayprivate.h"
+#include "gdkeventsprivate.h"
+#include "gdkdevicetoolprivate.h"
+#include "gdkkeysyms.h"
+
+#include "gdkiosruntime-private.h"
+#include "gdkiossurface-private.h"
+
+#include "gdkiosseat-private.h"
+
+/* ── device ─────────────────────────────────────────────────────────── */
+
+G_DEFINE_TYPE (GdkIosDevice, gdk_ios_device, GDK_TYPE_DEVICE)
+
+static void
+gdk_ios_device_finalize (GObject *object)
+{
+  GdkIosDevice *self = (GdkIosDevice *) object;
+  if (self->last)
+    g_object_remove_weak_pointer ((GObject *) self->last, (gpointer *) &self->last);
+  G_OBJECT_CLASS (gdk_ios_device_parent_class)->finalize (object);
+}
+
+static void
+gdk_ios_device_set_surface_cursor (GdkDevice *device, GdkSurface *surface, GdkCursor *cursor)
+{
+}
+
+static GdkSurface *
+gdk_ios_device_surface_at_position (GdkDevice *device, double *win_x, double *win_y, GdkModifierType *mask)
+{
+  GdkIosDevice *self = (GdkIosDevice *) device;
+  if (win_x)
+    *win_x = self->last_x;
+  if (win_y)
+    *win_y = self->last_y;
+  if (mask)
+    *mask = self->last_mods;
+  return (GdkSurface *) self->last;
+}
+
+static void
+gdk_ios_device_class_init (GdkIosDeviceClass *klass)
+{
+  GObjectClass *object_class = G_OBJECT_CLASS (klass);
+  GdkDeviceClass *device_class = GDK_DEVICE_CLASS (klass);
+
+  object_class->finalize = gdk_ios_device_finalize;
+  device_class->set_surface_cursor = gdk_ios_device_set_surface_cursor;
+  device_class->surface_at_position = gdk_ios_device_surface_at_position;
+}
+
+static void
+gdk_ios_device_init (GdkIosDevice *self)
+{
+}
+
+void
+gdk_ios_device_maybe_update_surface (GdkIosDevice *self, GdkIosSurface *new_surface,
+                                     GdkModifierType mods, guint32 time, double x, double y)
+{
+  GdkModifierType old_mods = self->last_mods;
+  double old_x = self->last_x, old_y = self->last_y;
+  self->last_x = x;
+  self->last_y = y;
+  self->last_mods = mods;
+  if (self->last == new_surface)
+    return;
+
+  GdkDisplay *display = gdk_device_get_display ((GdkDevice *) self);
+  if (self->last)
+    {
+      GdkEvent *ev = gdk_crossing_event_new (GDK_LEAVE_NOTIFY, (GdkSurface *) self->last, (GdkDevice *) self,
+                                             time, old_mods, old_x, old_y,
+                                             GDK_CROSSING_NORMAL, GDK_NOTIFY_UNKNOWN);
+      gdk_ios_seat_consume_event (display, ev);
+      g_object_remove_weak_pointer ((GObject *) self->last, (gpointer *) &self->last);
+    }
+  self->last = new_surface;
+  g_object_add_weak_pointer ((GObject *) self->last, (gpointer *) &self->last);
+  GdkEvent *ev = gdk_crossing_event_new (GDK_ENTER_NOTIFY, (GdkSurface *) new_surface, (GdkDevice *) self,
+                                         time, mods, x, y,
+                                         GDK_CROSSING_NORMAL, GDK_NOTIFY_UNKNOWN);
+  gdk_ios_seat_consume_event (display, ev);
+}
+
+void
+gdk_ios_device_keyboard_maybe_update_surface_focus (GdkIosDevice *self, GdkIosSurface *new_surface)
+{
+  if (self->last == new_surface)
+    return;
+  GdkDisplay *display = gdk_device_get_display ((GdkDevice *) self);
+  if (self->last)
+    {
+      GdkEvent *ev = gdk_focus_event_new ((GdkSurface *) self->last, (GdkDevice *) self, FALSE);
+      gdk_ios_seat_consume_event (display, ev);
+      g_object_remove_weak_pointer ((GObject *) self->last, (gpointer *) &self->last);
+    }
+  self->last = new_surface;
+  if (self->last)
+    {
+      g_object_add_weak_pointer ((GObject *) self->last, (gpointer *) &self->last);
+      GdkEvent *ev = gdk_focus_event_new ((GdkSurface *) self->last, (GdkDevice *) self, TRUE);
+      gdk_ios_seat_consume_event (display, ev);
+    }
+}
+
+void
+gdk_ios_device_forget_surface (GdkIosDevice *self, GdkIosSurface *surface)
+{
+  if (self->last == surface)
+    {
+      g_object_remove_weak_pointer ((GObject *) self->last, (gpointer *) &self->last);
+      self->last = NULL;
+    }
+}
+
+/* ── seat ───────────────────────────────────────────────────────────── */
+
+G_DEFINE_TYPE (GdkIosSeat, gdk_ios_seat, GDK_TYPE_SEAT)
+
+static void
+gdk_ios_seat_constructed (GObject *object)
+{
+  GdkIosSeat *self = (GdkIosSeat *) object;
+  GdkSeat *seat = (GdkSeat *) self;
+  G_OBJECT_CLASS (gdk_ios_seat_parent_class)->constructed (object);
+  GdkDisplay *display = gdk_seat_get_display (seat);
+
+  self->logical_pointer = g_object_new (GDK_TYPE_IOS_DEVICE,
+                                        "name", "iOS Pointer",
+                                        "source", GDK_SOURCE_MOUSE,
+                                        "has-cursor", TRUE,
+                                        "display", display,
+                                        "seat", seat,
+                                        NULL);
+  self->logical_touchscreen = g_object_new (GDK_TYPE_IOS_DEVICE,
+                                            "name", "iOS Touchscreen",
+                                            "source", GDK_SOURCE_TOUCHSCREEN,
+                                            "has-cursor", FALSE,
+                                            "display", display,
+                                            "seat", seat,
+                                            NULL);
+  self->logical_keyboard = g_object_new (GDK_TYPE_IOS_DEVICE,
+                                         "name", "iOS Keyboard",
+                                         "source", GDK_SOURCE_KEYBOARD,
+                                         "has-cursor", FALSE,
+                                         "display", display,
+                                         "seat", seat,
+                                         NULL);
+}
+
+static void
+gdk_ios_seat_finalize (GObject *object)
+{
+  GdkIosSeat *self = (GdkIosSeat *) object;
+  g_object_unref (self->logical_pointer);
+  g_object_unref (self->logical_touchscreen);
+  g_object_unref (self->logical_keyboard);
+  g_object_unref (self->finger);
+  G_OBJECT_CLASS (gdk_ios_seat_parent_class)->finalize (object);
+}
+
+static GdkSeatCapabilities
+gdk_ios_seat_get_capabilities (GdkSeat *seat)
+{
+  return GDK_SEAT_CAPABILITY_POINTER | GDK_SEAT_CAPABILITY_TOUCH | GDK_SEAT_CAPABILITY_KEYBOARD;
+}
+
+static GdkGrabStatus
+gdk_ios_seat_grab (GdkSeat *seat, GdkSurface *surface)
+{
+  GdkIosSeat *self = (GdkIosSeat *) seat;
+  GdkIosSurface *impl = (GdkIosSurface *) surface;
+  self->grab_surface = impl;
+  UIView *view = (UIView *) impl->view;
+  gdk_ios_run_on_main_sync (^{
+    gdk_ios_runtime_get_root_view ().grabbedView = view;
+  });
+  return GDK_GRAB_SUCCESS;
+}
+
+static void
+gdk_ios_seat_ungrab (GdkSeat *seat, GdkSurface *surface)
+{
+  GdkIosSeat *self = (GdkIosSeat *) seat;
+  self->grab_surface = NULL;
+  gdk_ios_run_on_main_sync (^{
+    gdk_ios_runtime_get_root_view ().grabbedView = nil;
+  });
+}
+
+static GdkDevice *
+gdk_ios_seat_get_logical_device (GdkSeat *seat, GdkSeatCapabilities capability)
+{
+  GdkIosSeat *self = (GdkIosSeat *) seat;
+  if (capability & (GDK_SEAT_CAPABILITY_POINTER | GDK_SEAT_CAPABILITY_TABLET_STYLUS))
+    return self->logical_pointer;
+  if (capability & GDK_SEAT_CAPABILITY_TOUCH)
+    return self->logical_touchscreen;
+  if (capability & GDK_SEAT_CAPABILITY_KEYBOARD)
+    return self->logical_keyboard;
+  return NULL;
+}
+
+static GList *
+gdk_ios_seat_get_devices (GdkSeat *seat, GdkSeatCapabilities capabilities)
+{
+  GdkIosSeat *self = (GdkIosSeat *) seat;
+  GList *devices = NULL;
+  if (capabilities & GDK_SEAT_CAPABILITY_POINTER)
+    devices = g_list_prepend (devices, self->logical_pointer);
+  if (capabilities & GDK_SEAT_CAPABILITY_TOUCH)
+    devices = g_list_prepend (devices, self->logical_touchscreen);
+  if (capabilities & GDK_SEAT_CAPABILITY_KEYBOARD)
+    devices = g_list_prepend (devices, self->logical_keyboard);
+  return g_list_reverse (devices);
+}
+
+static GList *
+gdk_ios_seat_get_tools (GdkSeat *seat)
+{
+  GdkIosSeat *self = (GdkIosSeat *) seat;
+  return g_list_prepend (NULL, self->finger);
+}
+
+static void
+gdk_ios_seat_class_init (GdkIosSeatClass *klass)
+{
+  GObjectClass *object_class = G_OBJECT_CLASS (klass);
+  GdkSeatClass *seat_class = (GdkSeatClass *) klass;
+
+  object_class->constructed = gdk_ios_seat_constructed;
+  object_class->finalize = gdk_ios_seat_finalize;
+  seat_class->get_capabilities = gdk_ios_seat_get_capabilities;
+  seat_class->grab = gdk_ios_seat_grab;
+  seat_class->ungrab = gdk_ios_seat_ungrab;
+  seat_class->get_logical_device = gdk_ios_seat_get_logical_device;
+  seat_class->get_devices = gdk_ios_seat_get_devices;
+  seat_class->get_tools = gdk_ios_seat_get_tools;
+}
+
+static void
+gdk_ios_seat_init (GdkIosSeat *self)
+{
+  self->finger = gdk_device_tool_new (1, 0, GDK_DEVICE_TOOL_TYPE_UNKNOWN, GDK_AXIS_FLAG_X | GDK_AXIS_FLAG_Y);
+}
+
+GdkIosSeat *
+gdk_ios_seat_new (GdkDisplay *display)
+{
+  return g_object_new (GDK_TYPE_IOS_SEAT, "display", display, NULL);
+}
+
+void
+gdk_ios_seat_consume_event (GdkDisplay *display, GdkEvent *event)
+{
+  GList *node = _gdk_event_queue_append (display, event);
+  _gdk_windowing_got_event (display, node, event, _gdk_display_get_next_serial (display));
+}
+
+/* ── keymap: hardware keycode == keyval ─────────────────────────────── */
+
+G_DEFINE_TYPE (GdkIosKeymap, gdk_ios_keymap, GDK_TYPE_KEYMAP)
+
+static PangoDirection
+gdk_ios_keymap_get_direction (GdkKeymap *keymap)
+{
+  return PANGO_DIRECTION_NEUTRAL;
+}
+
+static gboolean
+gdk_ios_keymap_false (GdkKeymap *keymap)
+{
+  return FALSE;
+}
+
+static gboolean
+gdk_ios_keymap_get_entries_for_keyval (GdkKeymap *keymap, guint keyval, GArray *array)
+{
+  GdkKeymapKey key = { .keycode = keyval, .group = 0, .level = 0 };
+  g_array_append_val (array, key);
+  return TRUE;
+}
+
+static gboolean
+gdk_ios_keymap_get_entries_for_keycode (GdkKeymap *keymap, guint hardware_keycode,
+                                        GdkKeymapKey **keys, guint **keyvals, int *n_entries)
+{
+  if (keys)
+    {
+      *keys = g_new (GdkKeymapKey, 1);
+      (*keys)[0] = (GdkKeymapKey){ .keycode = hardware_keycode, .group = 0, .level = 0 };
+    }
+  if (keyvals)
+    {
+      *keyvals = g_new (guint, 1);
+      (*keyvals)[0] = hardware_keycode;
+    }
+  *n_entries = 1;
+  return TRUE;
+}
+
+static guint
+gdk_ios_keymap_lookup_key (GdkKeymap *keymap, const GdkKeymapKey *key)
+{
+  return key->keycode;
+}
+
+static gboolean
+gdk_ios_keymap_translate_keyboard_state (GdkKeymap *keymap, guint hardware_keycode, GdkModifierType state,
+                                         int group, guint *keyval, int *effective_group, int *level,
+                                         GdkModifierType *consumed_modifiers)
+{
+  if (keyval)
+    *keyval = hardware_keycode;
+  if (effective_group)
+    *effective_group = 0;
+  if (level)
+    *level = 0;
+  if (consumed_modifiers)
+    *consumed_modifiers = 0;
+  return hardware_keycode != GDK_KEY_VoidSymbol;
+}
+
+static guint
+gdk_ios_keymap_get_modifier_state (GdkKeymap *keymap)
+{
+  return 0;
+}
+
+static void
+gdk_ios_keymap_class_init (GdkIosKeymapClass *klass)
+{
+  GdkKeymapClass *keymap_class = (GdkKeymapClass *) klass;
+  keymap_class->get_direction = gdk_ios_keymap_get_direction;
+  keymap_class->have_bidi_layouts = gdk_ios_keymap_false;
+  keymap_class->get_caps_lock_state = gdk_ios_keymap_false;
+  keymap_class->get_num_lock_state = gdk_ios_keymap_false;
+  keymap_class->get_scroll_lock_state = gdk_ios_keymap_false;
+  keymap_class->get_entries_for_keyval = gdk_ios_keymap_get_entries_for_keyval;
+  keymap_class->get_entries_for_keycode = gdk_ios_keymap_get_entries_for_keycode;
+  keymap_class->lookup_key = gdk_ios_keymap_lookup_key;
+  keymap_class->translate_keyboard_state = gdk_ios_keymap_translate_keyboard_state;
+  keymap_class->get_modifier_state = gdk_ios_keymap_get_modifier_state;
+}
+
+static void
+gdk_ios_keymap_init (GdkIosKeymap *self)
+{
+}
