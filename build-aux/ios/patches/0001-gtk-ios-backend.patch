+
+G_BEGIN_DECLS
+
+/* Main thread: queue a touch for the GTK thread. Coordinates in points, relative to the surface. */
+void gdk_ios_events_post_touch (GdkIosSurface *surface, GdkEventType type, guint sequence,
+                                double x, double y, guint32 time);
+
+/* Main thread: queue a key press+release pair for a unicode character (on-screen keyboard). */
