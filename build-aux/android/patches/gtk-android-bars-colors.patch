+	@Keep
+	public static void setBarsColors(int top, int bottom) {
+		barsOverrideTop = top;
+		barsOverrideBottom = bottom;
+		ToplevelActivity[] activities;
+		synchronized (liveActivities) {
+			activities = liveActivities.toArray(new ToplevelActivity[0]);
+		}
+		for (ToplevelActivity a : activities)
+			a.runOnUiThread(a::applyBarsColors);
+	}
+
+	private void applyBarsColors() {
+		if (view == null) return;
+		int fallback = lastGdkBarsColor;
+		int top = barsOverrideTop != 0 ? barsOverrideTop : resolveBarsColor("gtk_bars_top", fallback);
+		int bottom = barsOverrideBottom != 0 ? barsOverrideBottom : resolveBarsColor("gtk_bars_bottom", fallback);
+		view.setBarsColors(top, bottom);
