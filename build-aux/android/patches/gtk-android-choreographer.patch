+++ b/gdk/android/gdkandroidchoreographersource.c	2026-09-09 00:34:17.645251460 +0300
@@ -131,6 +131,22 @@
   gdk_android_choreographer_source_finalize,
 };
 
+/* AChoreographer_getInstance() is per thread and needs a Looper: on the
+ * GTK thread it returns NULL, leaving the frame clock without vsync (the
+ * spring animations of dialogs and sheets then paint only a few frames).
+ * The UI thread grabs its instance early (GlibContext.initChoreographer,
+ * called from RuntimeApplication.onCreate) and the source uses that. The
+ * callbacks run on the UI thread, which is what the source is written for. */
+static AChoreographer *ui_thread_choreographer = NULL;
+
+void
+_gdk_android_choreographer_init_ui_thread (JNIEnv *env, jclass klass)
+{
+  ui_thread_choreographer = AChoreographer_getInstance ();
+  if (ui_thread_choreographer == NULL)
+    g_warning ("GdkAndroidChoreographerSource: no choreographer on the UI thread either");
+}
+
 GSource *
 gdk_android_choreographer_source_new (GMainContext *context)
 {
@@ -146,6 +162,8 @@
 
   self->choreographer = AChoreographer_getInstance ();
   if (self->choreographer == NULL)
+    self->choreographer = ui_thread_choreographer;
+  if (self->choreographer == NULL)
     {
       g_warning ("GdkAndroidChoreographerSource: AChoreographer_getInstance() failed");
       g_source_unref (source);
