using Gtk 4.0;
using Adw 1;

// Two layouts over the same widgets: "wide" is the desktop bar (three equal
// columns), "narrow" stacks the transport row over the progress row and
// hides secondary controls. The window switches them by its width
// (PlayerBar.compact), not by a breakpoint: see application-window.vala.
template $CassettePlayerBar: Adw.Bin {
  sensitive: false;

  Adw.MultiLayoutView multi_layout {
    // The first layout is the default; layout-name cannot be set here
    // because the builder applies properties before adding the layouts.
    Adw.Layout {
      name: "wide";

      content: Grid {
        column-homogeneous: true;
        margin-top: 6;
        margin-bottom: 6;
        margin-start: 6;
        margin-end: 12;

        Adw.LayoutSlot {
          id: "carousel";

          layout {
            column: 0;
            column-span: 2;
          }
        }

        Adw.Clamp {
          maximum-size: 800;

          Box {
            orientation: vertical;
            hexpand: true;
            valign: center;
            margin-end: 12;
            margin-start: 12;

            CenterBox {
              halign: center;
              hexpand: true;

              start-widget: Box {
                halign: end;
                hexpand: true;
                spacing: 4;

                Adw.LayoutSlot {
                  id: "repeat";
                }

                Adw.LayoutSlot {
                  id: "dislike";
                }

                Adw.LayoutSlot {
                  id: "prev";
                }
              };

              center-widget: Adw.LayoutSlot {
                id: "play";
              };

              end-widget: Box {
                halign: start;
                hexpand: true;
                spacing: 4;

                Adw.LayoutSlot {
                  id: "next";
                }

                Adw.LayoutSlot {
                  id: "like";
                }

                Adw.LayoutSlot {
                  id: "shuffle";
                }
              };
            }

            Adw.LayoutSlot {
              id: "progress";
            }
          }

          layout {
            column: 2;
            column-span: 3;
          }
        }

        Box {
          spacing: 4;
          halign: end;

          Adw.LayoutSlot {
            id: "save";
          }

          Adw.LayoutSlot {
            id: "flow-settings";
          }

          Adw.LayoutSlot {
            id: "queue";
          }

          Adw.LayoutSlot {
            id: "options";
          }

          Adw.LayoutSlot {
            id: "output";
          }

          Adw.LayoutSlot {
            id: "volume";
          }

          Adw.LayoutSlot {
            id: "fullscreen";
          }

          layout {
            column: 5;
            column-span: 2;
          }
        }
      };
    }

    Adw.Layout {
      name: "narrow";

      content: Box {
        orientation: vertical;
        spacing: 2;
        margin-top: 4;
        margin-bottom: 4;
        margin-start: 6;
        margin-end: 6;

        Box {
          spacing: 2;

          Adw.LayoutSlot {
            id: "carousel";
            hexpand: true;
          }

          Adw.LayoutSlot {
            id: "prev";
          }

          Adw.LayoutSlot {
            id: "play";
          }

          Adw.LayoutSlot {
            id: "next";
          }

          Adw.LayoutSlot {
            id: "like";
          }

          Adw.LayoutSlot {
            id: "output";
          }

          Adw.LayoutSlot {
            id: "options";
          }
        }

        Adw.LayoutSlot {
          id: "progress";
        }

        // Not shown on phones: hardware volume keys, and the rest lives in
        // the track menu / sidebar. Slots must exist in every layout.
        Box {
          visible: false;

          Adw.LayoutSlot {
            id: "repeat";
          }

          Adw.LayoutSlot {
            id: "dislike";
          }

          Adw.LayoutSlot {
            id: "shuffle";
          }

          Adw.LayoutSlot {
            id: "save";
          }

          Adw.LayoutSlot {
            id: "flow-settings";
          }

          Adw.LayoutSlot {
            id: "queue";
          }

          Adw.LayoutSlot {
            id: "volume";
          }

          Adw.LayoutSlot {
            id: "fullscreen";
          }
        }
      };
    }

    Adw.Layout {
      name: "tiny";

      content: Box {
        orientation: vertical;
        spacing: 2;
        margin-top: 4;
        margin-bottom: 4;
        margin-start: 4;
        margin-end: 4;

        Box {
          spacing: 0;

          Adw.LayoutSlot {
            id: "carousel";
            hexpand: true;
          }

          Adw.LayoutSlot {
            id: "prev";
          }

          Adw.LayoutSlot {
            id: "play";
          }

          Adw.LayoutSlot {
            id: "next";
          }

          Adw.LayoutSlot {
            id: "options";
          }
        }

        Adw.LayoutSlot {
          id: "progress";
        }

        // Like lives in the track menu and the system media controls,
        // the output picker in the primary menu.
        Box {
          visible: false;

          Adw.LayoutSlot {
            id: "like";
          }

          Adw.LayoutSlot {
            id: "output";
          }

          Adw.LayoutSlot {
            id: "repeat";
          }

          Adw.LayoutSlot {
            id: "dislike";
          }

          Adw.LayoutSlot {
            id: "shuffle";
          }

          Adw.LayoutSlot {
            id: "save";
          }

          Adw.LayoutSlot {
            id: "flow-settings";
          }

          Adw.LayoutSlot {
            id: "queue";
          }

          Adw.LayoutSlot {
            id: "volume";
          }

          Adw.LayoutSlot {
            id: "fullscreen";
          }
        }
      };
    }

    [carousel]
    Button track_detailed_button {
      styles [
        "flat",
        "button-standart-padding"
      ]

      halign: fill;
      hexpand: true;
      tooltip-text: _("Show track info");

      $CassetteTrackCarousel track_carousel {
        interactive: false;
        spacing: 4;
        halign: start;
        orientation: horizontal;
      }
    }

    [repeat]
    Button repeat_button {
      styles [
        "circular",
        "flat"
      ]

      valign: center;
      action-name: "app.change-repeat";
      icon-name: "media-playlist-repeat-song-symbolic";
      tooltip-text: _("Change repeat mode");
    }

    [dislike]
    $CassetteDislikeButton dislike_button {
      styles [
        "flat",
        "circular"
      ]

      object-content-type: track;
      margin-end: 8;
    }

    [prev]
    Button prev_track_button {
      styles [
        "circular",
        "flat"
      ]

      valign: center;
      action-name: "app.prev";
      icon-name: "media-skip-backward-symbolic";
      tooltip-text: _("Play previous track");
    }

    [play]
    Button play_button {
      styles [
        "flat",
        "circular"
      ]

      action-name: "app.play-pause";
      valign: center;
      margin-start: 4;
      margin-end: 4;

      $CassettePlayMarkGlobal play_mark_global {}
    }

    [next]
    Button next_track_button {
      styles [
        "circular",
        "flat"
      ]

      valign: center;
      action-name: "app.next";
      icon-name: "media-skip-forward-symbolic";
      tooltip-text: _("Play next track");
    }

    [like]
    $CassetteLikeButton like_button {
      styles [
        "flat",
        "circular"
      ]

      margin-start: 8;
      object-content-type: "track";
    }

    [shuffle]
    Button shuffle_button {
      styles [
        "circular",
        "flat"
      ]

      valign: center;
      action-name: "app.change-shuffle";
      icon-name: "media-playlist-shuffle-symbolic";
      tooltip-text: _("Change shuffle mode");
    }

    [progress]
    Box {
      spacing: 4;

      Label current_time_mark {
        styles [
          "dim-label",
          "caption"
        ]

        label: "0:00";
        halign: start;
        width-request: 32;
      }

      Scale slider {
        hexpand: true;
        orientation: horizontal;

        adjustment: Adjustment {
          lower: 0.0;
          value: 0.0;
          page-increment: 5.0;
        };
      }

      Label total_time_mark {
        styles [
          "dim-label",
          "caption"
        ]

        label: "0:00";
        halign: end;
        width-request: 32;
      }
    }

    [save]
    $CassetteSaveStack save_stack {
      halign: "end";
      content-type: "track";
    }

    [flow-settings]
    Button flow_settings_button {
      styles [
        "flat"
      ]

      valign: center;
      icon-name: "music-note-symbolic";
      tooltip-text: _("Show wave settings");
    }

    [queue]
    Button queue_show_button {
      styles [
        "flat"
      ]

      valign: center;
      icon-name: "music-queue-symbolic";
      tooltip-text: _("Show playback queue");
    }

    [options]
    $CassetteTrackOptionsButton track_options_button {
      styles [
        "flat",
      ]

      valign: center;
    }

    [output]
    $CassetteOutputButton output_button {}

    [volume]
    $CassetteVolumeButton volume_button {
      valign: center;
      tooltip-text: _("Change volume");
    }

    [fullscreen]
    Button fullscreen_button {
      styles [
        "flat"
      ]

      valign: center;
      visible: false;
      icon-name: "view-fullscreen-symbolic";
    }
  }
}
