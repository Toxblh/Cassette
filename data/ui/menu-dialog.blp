using Gtk 4.0;
using Adw 1;

template $CassetteMenuDialog: Adw.Dialog {
  presentation-mode: bottom_sheet;

  $CassetteShrinkableBin shrinkable_bin {
    Box {
      orientation: vertical;
      spacing: 7;

      // No vexpand here: while the bottom sheet slides in, libadwaita lays
      // the content out in the visible part of the sheet, and an expanding
      // title pinned the menu to the bottom edge instead of sliding with it.
      Adw.Clamp title_clamp {
        valign: start;
        margin-end: 7;
        margin-start: 7;
        margin-top: 19;
      }

      ScrolledWindow scrolled_window {
        hscrollbar-policy: never;
        vscrollbar-policy: automatic;
        propagate-natural-height: true;

        Adw.Clamp menu_clamp {
          margin-end: 12;
          margin-start: 12;
          margin-bottom: 12;
        }
      }
    }
  }
}
